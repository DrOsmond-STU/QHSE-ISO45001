  locationDetail       String? @map("location_detail") @db.VarChar(200)
  description          String  @db.Text
  immediateActionTaken String? @map("immediate_action_taken") @db.Text

  // NULL kalau isAnonymous=TRUE (BR-04 — mode anonim hanya berlaku kalau
  // diaktifkan sejak awal pelaporan, tidak dapat diubah setelah submit).
  reportedBy     String? @map("reported_by") @db.Uuid
  reportedByUser User?   @relation("IncidentReportReportedBy", fields: [reportedBy], references: [id])
  isAnonymous    Boolean @default(false) @map("is_anonymous")

  // Referensi saja (BR-05) — detail medis lengkap di Modul 13 (belum ada).
  injuredPersonId String? @map("injured_person_id") @db.Uuid
  injuredPerson   User?   @relation("IncidentReportInjuredPerson", fields: [injuredPersonId], references: [id])

  workPermitId String?     @map("work_permit_id") @db.Uuid
  workPermit   WorkPermit? @relation(fields: [workPermitId], references: [id])

  involvesContractor  Boolean     @default(false) @map("involves_contractor")
  // Task 6.3 — FK sungguhan ke contractors (Modul 17), sebelumnya bare UUID
  // TANPA FK sejak 3.5, pola PERSIS work_permits.contractorCompanyId di atas.
  // Sumber data agregat contractor_performance_evaluations.incident_count (§4.4).
  contractorCompanyId String?     @map("contractor_company_id") @db.Uuid
  contractorCompany   Contractor? @relation(fields: [contractorCompanyId], references: [id])

  status IncidentReportStatus @default(REPORTED)

  daysLost      Int?     @map("days_lost")
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(15, 2)

  customFields Json @default("{}") @map("custom_fields") @db.JsonB

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("IncidentReportCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("IncidentReportUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  investigations        IncidentInvestigation[]
  witnessStatements     IncidentWitnessStatement[]
  regulatoryReports     IncidentRegulatoryReport[]
  correctiveActionLinks IncidentCorrectiveAction[]
  emergencyActivations  EmergencyActivation[]
  // Task 5.3 — Occupational Health (kunjungan klinik terkait insiden)
  clinicVisitLogs       ClinicVisitLog[]
  // Task 6.2 — Calibration Management (OOT berdampak K3 lapangan)
  outOfToleranceRecords OutOfToleranceRecord[]

  @@unique([tenantId, incidentNumber])
  @@index([tenantId, status])
  @@index([tenantId, siteId])
  @@map("incident_reports")
}

// PRD §4 poin 7 "HSE Manager menyetujui via Workflow Engine
// (entity_type=incident_investigation)" — SATU-SATUNYA workflowInstanceId
