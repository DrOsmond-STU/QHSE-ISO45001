// APPEND-ONLY (§11 Immutability) — pola PERSIS system_audit_logs (task
// 0.13): migration RLS meng-GRANT SELECT,INSERT lalu REVOKE UPDATE,DELETE
// dari qhse_app secara eksplisit (BUKAN trigger — ALTER DEFAULT PRIVILEGES
// dari migration 0.8/0.11/0.12 otomatis kasih UPDATE/DELETE ke SEMUA tabel
// baru kalau tidak di-REVOKE eksplisit di sini). BUKAN audit-trigger
// standar (tabel ini SENDIRI adalah jejak audit, mengaudit-trail dirinya
// sendiri sirkular & tidak perlu). TIDAK punya updatedAt/deletedAt sama
// sekali — literal PRD §5 (beda dari SELURUH tabel lain modul ini/sesi ini).
model MedicalRecordAccessLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("access_log_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  accessedByUserId String @map("accessed_by_user_id") @db.Uuid
  accessedByUser   User   @relation("MedicalRecordAccessLogAccessedBy", fields: [accessedByUserId], references: [id])

  subjectEmployeeUserId String @map("subject_employee_user_id") @db.Uuid
  subjectEmployeeUser   User   @relation("MedicalRecordAccessLogSubjectEmployee", fields: [subjectEmployeeUserId], references: [id])

  // Polymorphic, TANPA FK (pola sama workflow_instances.entityId/attachments.entityId).
  accessedEntityType OhAccessEntityType @map("accessed_entity_type")
  accessedEntityId   String             @map("accessed_entity_id") @db.Uuid

  accessType      OhAccessType   @map("access_type")
  reasonForAccess OhAccessReason @map("reason_for_access")
  reasonNotes     String?        @map("reason_notes") @db.Text

  // Nullable (BEDA dari kolom lain di tabel ini yang literal PRD §5 kosong
  // = wajib) — dikoreksi setelah kontak dengan kenyataan (task 256):
  // getCurrentIpAddress() (platform/observability/request-context.ts)
  // legitimately undefined di luar HTTP request (test/scheduled job), DAN
  // system_audit_logs.ipAddress/UserSession.ipAddress SUDAH nullable
  // duluan (preseden platform), jadi memaksa NOT NULL di sini cuma akan
  // memaksa nilai IP palsu demi lolos constraint yang tidak mencerminkan
  // invariant nyata — BR-01 soal LOG WRITE-nya berhasil, bukan soal
  // ip_address spesifik selalu ada.
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)

  accessedAt DateTime @default(now()) @map("accessed_at") @db.Timestamptz

  @@index([tenantId, subjectEmployeeUserId, accessedAt])
  @@index([tenantId, accessedByUserId, accessedAt])
  @@index([tenantId, accessedEntityType, accessedEntityId])
  @@map("medical_record_access_logs")
}

