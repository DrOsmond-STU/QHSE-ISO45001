  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("GasTestResultUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, workPermitId])
  @@map("gas_test_results")
}

// Prinsip verifikasi independen — verifiedBy WAJIB beda dari appliedBy
// (BR terkait PRD §5, ditegakkan IsolationLotoRecordService.verify(),
// BUKAN constraint DB krn perbandingan dua kolom nullable-vs-required
// butuh CHECK yang rumit utk sedikit manfaat tambahan di atas app-level guard).
model IsolationLotoRecord {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("isolation_loto_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  workPermitId String     @map("work_permit_id") @db.Uuid
  workPermit   WorkPermit @relation(fields: [workPermitId], references: [id])

  isolationPointDescription String        @map("isolation_point_description") @db.VarChar(200)
  isolationType             IsolationType @map("isolation_type")
