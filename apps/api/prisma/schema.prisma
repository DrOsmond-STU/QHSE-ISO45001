// ── Task 1.5 — System Administration: provisioning & entitlement (Modul 31 §5) ──

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum TenantSubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UsageMetricType {
  ACTIVE_USERS
  ACTIVE_SITES
}

// Katalog GLOBAL platform (PRD literal: "platform-level, bukan per tenant")
// — TIDAK ADA tenant_id sama sekali, pola PERSIS industry_templates (1.2):
// otomatis terkecualikan generic RLS suite, ditulis lewat
// PrismaService.withGlobalContext() (1.2), diseed lewat migration
// terkontrol (TDD §6.3).
model SubscriptionPlan {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @map("subscription_plan_id") @db.Uuid
  planName            String   @map("plan_name") @db.VarChar(100)
  includedModuleCodes String[] @map("included_module_codes")
  maxUsers            Int?     @map("max_users")
  maxSites            Int?     @map("max_sites")
  isActive            Boolean  @default(true) @map("is_active")

  tenantSubscriptions TenantSubscription[]

  @@map("subscription_plans")
