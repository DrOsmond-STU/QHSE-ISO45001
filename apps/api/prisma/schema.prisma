// Cache/read-model — PRD §5 eksplisit "BUKAN pengganti Workflow Engine,
// sumber kebenaran tetap workflow_instances/workflow_tasks."
// WorkPermitApprovalCacheService.refresh() (task 3.3) yang mengisinya,
// dipanggil saat submit + saat WORKFLOW_INSTANCE_COMPLETED_EVENT — TIDAK
// ADA hook per-stage-advance dari WorkflowEngineService (0.9) saat ini,
// jadi field issuer_approved_by/at bisa STALE di antara kedua titik itu
// sampai caller (controller masa depan) memanggil refresh() eksplisit
// sesudah tiap actOnTask() — gap TDD §26.
model WorkPermitApproval {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("work_permit_approval_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
