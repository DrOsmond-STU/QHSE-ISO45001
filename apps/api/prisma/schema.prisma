  workPermitId String     @map("work_permit_id") @db.Uuid
  workPermit   WorkPermit @relation(fields: [workPermitId], references: [id])

  gasType       GasType            @map("gas_type")
  readingValue  Decimal            @map("reading_value") @db.Decimal(10, 3)
  unit          String             @db.VarChar(20)
  acceptableMin Decimal?           @map("acceptable_min") @db.Decimal(10, 3)
  acceptableMax Decimal?           @map("acceptable_max") @db.Decimal(10, 3)
  result        GasTestResultValue

  testDatetime DateTime  @map("test_datetime") @db.Timestamptz
  retestDueAt  DateTime? @map("retest_due_at") @db.Timestamptz

