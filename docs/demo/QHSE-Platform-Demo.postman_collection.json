  "item": [
    {
      "name": "00 - Auth",
      "description": "OAuth2 Authorization Code + PKCE, same flow the real web app uses. codeVerifier/codeChallenge above are a FIXED precomputed pair (fine for a demo login, not a security-critical flow) — run both requests in order once per session; {{accessToken}} then auto-fills for every other request in this collection via the collection-level Bearer auth.",
      "item": [
        {
          "name": "1. Login (get authorization code)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\",\n  \"codeChallenge\": \"{{codeChallenge}}\",\n  \"codeChallengeMethod\": \"S256\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Step 1 of 2. Body email/password default to Tenant Admin (budi.santoso). Change the loginEmail/loginPassword collection variables to try a different demo role — see DEMO_GUIDE.md for the full roster of 23 logins (all share password Demo!QHSE2026)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"200 OK with authorization code\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.data.code).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"authCode\", json.data.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Token Exchange (get access token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"authorization_code\",\n  \"code\": \"{{authCode}}\",\n  \"codeVerifier\": \"{{codeVerifier}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/token", "host": ["{{baseUrl}}"], "path": ["auth", "token"] },
            "description": "Step 2 of 2. Consumes the one-time authCode from Step 1. Access token expires in 900s (15 min) — just re-run both Auth requests if later requests start returning 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"200 OK with access token\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.data.accessToken).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"accessToken\", json.data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
