// Dipakai DUA tabel — emergency_response_plan_steps.responsible_ert_role
// DAN emergency_response_team_members.ert_role (PRD §5 plan_steps eksplisit
// "mengacu daftar ert_role" yang sama) — satu enum di-reuse, bukan duplikat.
enum ErtRole {
  INCIDENT_COMMANDER
  DEPUTY_INCIDENT_COMMANDER
  FIRE_WARDEN
  FIRST_AIDER
  EVACUATION_MARSHAL
  SECURITY_COORDINATOR
  COMMUNICATION_OFFICER
  HAZMAT_RESPONSE_OFFICER
  ASSEMBLY_POINT_COORDINATOR
  OTHER
}

enum EmergencyTeamType {
  SITE_WIDE
  SHIFT_BASED
  BUILDING_SPECIFIC
}

enum EmergencyTeamMemberStatus {
  ACTIVE
  INACTIVE
}

enum EmergencyContactCategory {
  INTERNAL_ERT
  HOSPITAL
  FIRE_DEPARTMENT
  POLICE
  AMBULANCE
  GOVERNMENT_AGENCY
  SKK_MIGAS
  ENVIRONMENTAL_AGENCY
  UTILITY_PLN_PDAM
  POISON_CONTROL
  OTHER
}

enum EmergencyDrillType {
  TABLETOP
  FUNCTIONAL
  FULL_SCALE_EVACUATION
}

enum EmergencyDrillStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

