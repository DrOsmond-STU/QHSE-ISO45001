// Shared-hosting adaptation (REDIS_ENABLED=false) — pengganti SessionStore
// Redis (RedisSessionStore, key `session:{user_id}:{session_id}`). SENGAJA
// tabel TERPISAH dari UserSession di bawah, BUKAN reuse — UserSession dibuat
// SETELAH RefreshTokenService.issue() (lihat auth.service.ts login(): issue()
// dipanggil dulu, baru tx.userSession.create()), dan sessionTokenHash-nya
// eksplisit "hashForAudit" (snapshot sekali di awal, TIDAK diupdate tiap
// rotate() spt SessionStore) — beda tujuan: UserSession = audit/tampilan
// "sesi aktif user" utk admin, tabel ini = state keamanan LIVE (hash SECRET
// TERKINI) yang genuinely dipakai reuse-detection tiap rotate(). RLS
// diaktifkan (konsisten tabel lain) TAPI diakses lewat client admin (bypass
// RLS) di DbSessionStore — get(userId, sessionId) dipanggil SEBELUM tenant
// diketahui (tenantId baru terbaca DARI baris ini), pola sama alasan
// authorization-code.service.ts tidak scoped tenant di level query.
model SessionCacheEntry {
  userId            String   @map("user_id") @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  currentSecretHash String   @map("current_secret_hash") @db.VarChar(64)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([userId, sessionId])
  @@index([userId])
  @@index([expiresAt])
  @@map("session_cache_entries")
}

// Shared-hosting adaptation (REDIS_ENABLED=false) — pengganti authcode:{code}
// Redis (AuthorizationCodeService, TTL 60s). Code sendiri (32 byte random,
// base64url) sudah jadi PK — tidak ada tenant/userId di WHERE clause saat
// lookup (pola sama alasan SessionCacheEntry di atas: konsumsi lewat
// possession kode acak, bukan scoping tenant), RLS TIDAK diaktifkan di
// tabel ini (beda dari SessionCacheEntry) krn diakses murni via admin
// client + tidak ada baris "milik tenant lain yang perlu disembunyikan" —
// satu baris HANYA readable kalau tahu persis code-nya (256-bit entropy).
model AuthorizationCodeEntry {
  code             String   @id @db.VarChar(64)
  userId           String   @map("user_id") @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  codeChallenge    String   @map("code_challenge") @db.VarChar(255)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("authorization_code_entries")
}

model UserSession {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation("UserSessionTenant", fields: [tenantId], references: [id])
  userId   String @map("user_id") @db.Uuid

  loginAt    DateTime   @default(now()) @map("login_at") @db.Timestamptz
  logoutAt   DateTime?  @map("logout_at") @db.Timestamptz
  ipAddress  String?    @map("ip_address") @db.VarChar(45)
  userAgent  String?    @map("user_agent") @db.VarChar(255)
  deviceType DeviceType @default(WEB) @map("device_type")

  // Hash dari refresh token AKTIF saat ini (rotasi wajib — TDD §8.1). Token
  // asli tidak pernah disimpan plaintext (PRD Modul 02 §11).
  sessionTokenHash String @map("session_token_hash") @db.VarChar(255)

  expiresAt     DateTime @map("expires_at") @db.Timestamptz
  revoked       Boolean  @default(false)
  // VARCHAR (contoh nilai PRD): USER_LOGOUT / ADMIN_FORCE_LOGOUT / PASSWORD_CHANGED /
  // SUSPENDED / TOKEN_REUSE_DETECTED (ditambah task 0.6 — reuse detection §TDD 8.1)
  revokedReason String?  @map("revoked_reason") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

model PasswordPolicy {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("password_policy_id") @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  minLength            Int     @default(8) @map("min_length")
  requireUppercase     Boolean @default(true) @map("require_uppercase")
  requireLowercase     Boolean @default(true) @map("require_lowercase")
  requireNumber        Boolean @default(true) @map("require_number")
  requireSpecialChar   Boolean @default(true) @map("require_special_char")
  passwordExpiryDays   Int?    @map("password_expiry_days")
  // Enforcement histori password ditunda — belum ada endpoint ganti password
  // di task 0.6 (lihat plan §7/§9 catatan gap).
  passwordHistoryCount Int     @default(5) @map("password_history_count")

  maxFailedAttempts      Int     @default(5) @map("max_failed_attempts")
  lockoutDurationMinutes Int     @default(30) @map("lockout_duration_minutes")
  mfaRequired            Boolean @default(false) @map("mfa_required") // dibaca task 0.7, belum di-enforce 0.6
  sessionTimeoutMinutes  Int     @default(60) @map("session_timeout_minutes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("password_policies")
}

// ── Task 0.8 — RBAC Engine ───────────────────────────────────────────
// Subset minimal-tapi-nyata (nama tabel/kolom PERSIS Modul 02) yang genuinely
// dibutuhkan PermissionService. Kolom Modul 02 penuh (mis. roles.based_on_role_id
// lengkap dgn UI clone, full audit before/after, role_permissions.scope_constraint
// evaluation) menyusul task 1.3 lewat ALTER TABLE ADD COLUMN. scope_id: TETAP
// bare UUID tanpa FK PERMANEN (bukan sementara menunggu 1.1) — polymorphic,
// merujuk companies/branches/sites/departments TERGANTUNG nilai scopeType,
// dan Postgres FK constraint tidak bisa "kondisional per baris" ke 4 tabel
// berbeda (satu kolom FK cuma bisa menunjuk SATU tabel target). Pola sama
// entity_id di WorkflowInstance/Attachment/SystemAuditLog — validasi
// keberadaan baris target (kalau diperlukan) jadi tanggung jawab service
// layer, bukan constraint DB. tenant_id User/UserSession (beda kasus, TIDAK
// polymorphic) sudah di-FK-kan ke tenants sejak task 1.1.

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum UserRoleStatus {
  ACTIVE
  INACTIVE
}

enum ScopeType {
  TENANT
  COMPANY
  BRANCH
  SITE
  DEPARTMENT
}

model Role {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  tenantId     String? @map("tenant_id") @db.Uuid // NULL = system role (lintas tenant, template)
  roleCode     String  @map("role_code") @db.VarChar(50)
  name         String  @db.VarChar(100)
  description  String? @db.Text
  isSystemRole Boolean @default(false) @map("is_system_role") // BR-05 — immutable, hanya bisa di-clone

  // BR-05 (task 1.3) — terisi kalau role ini hasil clone dari role sistem
  // (RoleService.cloneSystemRole()); role sistem sendiri (isSystemRole=true)
  // basedOnRoleId-nya selalu NULL (akar clone, bukan hasil clone).
  basedOnRoleId String? @map("based_on_role_id") @db.Uuid
  basedOnRole   Role?   @relation("RoleClonedFrom", fields: [basedOnRoleId], references: [id])
  clonedRoles   Role[]  @relation("RoleClonedFrom")

  status RoleStatus @default(ACTIVE)

  // Nullable (BUKAN "audit standar" strict NOT NULL seperti companies/dst,
  // task 1.1) — pola sama User.createdBy/RolePermission.createdBy: role
  // SISTEM di-seed platform (seed-rbac-baseline.ts), tanpa aktor manusia.
  createdBy     String?   @map("created_by") @db.Uuid
  createdByUser User?     @relation("RoleCreatedByUser", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String?   @map("updated_by") @db.Uuid
  updatedByUser User?     @relation("RoleUpdatedByUser", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  rolePermissions        RolePermission[]
  userRoles              UserRole[]
  ssoMappingDefaultFor   SsoMapping[]            @relation("SsoMappingDefaultRole")
  workflowDelegations    WorkflowDelegation[]
  delegationsOfAuthority DelegationOfAuthority[]

  // Task 0.9 — Workflow Engine
  approverForStages   WorkflowStage[] @relation("WorkflowStageApproverRole")
  escalationForStages WorkflowStage[] @relation("WorkflowStageEscalationRole")

  // Task 6.1 — Asset & Equipment Management
  maintenanceSchedulesResponsible MaintenanceSchedule[]

  @@unique([tenantId, roleCode])
  @@map("roles")
}

model PermissionGroup {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @map("permission_group_id") @db.Uuid
  moduleCode String   @map("module_code") @db.VarChar(50)
