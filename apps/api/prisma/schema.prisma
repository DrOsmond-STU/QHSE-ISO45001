// Task 6.2 (Modul 16 Calibration Management), modul DOMAIN KEDUA PULUH.
// Extend `assets` (6.1) khusus subset Measuring & Test Equipment — 5 tabel
// baru + 7 enum. Beberapa deviasi dari PRD literal, dicatat di sini (gap TDD
// §26 detail lengkap):
// (1) BR-01 ("maksimal 1 calibration_items AKTIF per aset") TERPENUHI BY
//     CONSTRUCTION oleh `@unique` pada `CalibrationItem.assetId` (PRD §5
//     schema table SENDIRI sebut kolom ini "UNIQUE" tanpa syarat — lebih
//     ketat dari "aktif", jadi otomatis mencakupnya, pola sama beberapa BR
//     "by construction" sebelumnya mis. CAPA BR-06/Quality BR-06).
// (2) BR-08 (perubahan assets.site_id wajib sinkron calibration_items.site_id
//     event-driven) — AssetTransferService.transfer() (6.1, SUDAH SELESAI)
//     TIDAK pernah emit event apa pun; ditambah event stub
//     ASSET_SITE_CHANGED_EVENT retroaktif (perubahan aditif murni, tidak
//     mengubah perilaku existing) dikonsumsi CalibrationItemAssetSiteSyncListener
//     BARU yang hidup DI modul ini — pola sama Audit 4.1 menambah stub
//     event utk CAPA yang belum ada saat itu.
// (3) `calibration_schedules.reminder_days_before` (PRD §5, INT[]/JSONB
//     per-BARIS configurable, default [30,14,7,1]) TIDAK diimplementasikan
//     sbg kolom truly configurable — dipakai 4 kolom idempotency TETAP
//     (reminderSentAtDay30/14/7/1) mengikuti tier default PRD sendiri, pola
//     established "N kolom timestamp terpisah utk N ambang" (licenses_permits
//     2.2), BUKAN array/JSONB per-baris yang tidak akan pernah dihormati.
// (4) `equipment_tag_no` PRD sebut "salinan dari assets.asset_tag_no" — Modul
//     15 (6.1) SUNGGUHAN TIDAK PUNYA kolom asset_tag_no (namanya assetCode,
//     preseden mismatch nama field lintas dokumen PRD, pola sama gap BR-05
//     Modul 04 2.2) — didenormalisasi dari assets.assetCode sebagai gantinya.
// (5) BR-05 (review certificate ditolak jika provider accreditation lewat,
//     kecuali INTERNAL_LAB atau "override manual dgn justifikasi tercatat
//     system_audit_logs") — diwujudkan sbg override manual di
//     CalibrationCertificateService.submitForReview() +
//     `AuditLogService.recordStandalone()` (0.13, platform primitive
//     semantic-entry existing) TANPA Workflow Engine terpisah (PRD tidak
//     minta workflow formal utk override ini, beda dari review sertifikat
//     §4.1 poin 6 yang eksplisit minta Workflow Engine). BR-06
//     (requires_capa=true wajib utk item kritis, PRD §6 literal sebut
//     "override FALSE butuh approval HSE Manager+justifikasi") SEBALIKNYA
//     TIDAK PUNYA jalur override sama sekali — OutOfToleranceRecordService
//     (assessImpact()) SELALU menghitung requires_capa via OR murni
//     (isCapaRequiredAfterImpactAssessment(), calibration-lifecycle.ts),
//     tidak menerima nilai override caller-supplied apa pun — item kritis
//     SELALU requires_capa=true tanpa jalan keluar, LEBIH KETAT dari PRD
//     (bukan lebih longgar, jadi bukan gap keamanan, tapi TETAP gap TDD §26
//     krn PRD eksplisit minta mekanisme approval+justifikasi yang tidak ada
//     kodenya — komentar versi sebelumnya banner ini SALAH mengklaim kedua
//     BR ini simetris, dikoreksi task 292/dokumentasi, gap TDD §26 metodologi
//     tambahan: banner comment sendiri bisa jadi sumber gap kalau tidak
//     ditinjau ulang thd kode sungguhan).
model CalibrationItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("calibration_item_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  assetId String @unique @map("asset_id") @db.Uuid
  asset   Asset  @relation(fields: [assetId], references: [id])

  // Didenormalisasi dari assets.site_id (BR-08) — lihat banner comment blok
  // modul ini poin (2) utk mekanisme sinkronisasi event-driven.
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id])

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  // Didenormalisasi dari assets.assetCode — lihat banner comment poin (4).
  equipmentTagNo String? @map("equipment_tag_no") @db.VarChar(50)

  measurementParameter String   @map("measurement_parameter") @db.VarChar(100)
  measurementRangeMin  Decimal? @map("measurement_range_min") @db.Decimal
  measurementRangeMax  Decimal? @map("measurement_range_max") @db.Decimal
  measurementRangeUnit String?  @map("measurement_range_unit") @db.VarChar(20)
  accuracyClass        String?  @map("accuracy_class") @db.VarChar(50)
  resolution           String?  @db.VarChar(30)

  calibrationIntervalMonths Int     @map("calibration_interval_months")
  calibrationMethodStandard String? @map("calibration_method_standard") @db.VarChar(150)

  // Default awal dari assets.isSafetyCritical (Modul 15) saat create(), dapat
  // di-override manual — PRD §5 literal.
  isCriticalMeasurement Boolean @default(false) @map("is_critical_measurement")

  calibrationStatus CalibrationItemStatus @default(ACTIVE) @map("calibration_status")
  isActive          Boolean               @default(true) @map("is_active")

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("CalibrationItemCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("CalibrationItemUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  schedules             CalibrationSchedule[]
  certificates          CalibrationCertificate[]
  outOfToleranceRecords OutOfToleranceRecord[]

  @@index([tenantId, siteId])
  @@index([tenantId, calibrationStatus])
  @@map("calibration_items")
}

model CalibrationProvider {
