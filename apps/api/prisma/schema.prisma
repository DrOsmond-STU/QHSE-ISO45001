  hseApprovedBy     String?   @map("hse_approved_by") @db.Uuid
  hseApprovedByUser User?     @relation("WorkPermitApprovalHseApprover", fields: [hseApprovedBy], references: [id])
  hseApprovedAt     DateTime? @map("hse_approved_at") @db.Timestamptz

  finalDecision   WorkPermitApprovalDecision @default(PENDING) @map("final_decision")
