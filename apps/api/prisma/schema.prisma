  // Modul 16 (Calibration Management) BELUM ADA — bare UUID TANPA FK.
  instrumentCalibrationRef String? @map("instrument_calibration_ref") @db.Uuid

  testedBy     String @map("tested_by") @db.Uuid
  testedByUser User   @relation("GasTestResultTestedBy", fields: [testedBy], references: [id])

  locationDetail String? @map("location_detail") @db.VarChar(200)
