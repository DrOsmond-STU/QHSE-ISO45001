  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("InspectionScheduleUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  records InspectionRecord[]

  @@index([tenantId, isActive, nextGenerationDate])
  @@map("inspection_schedules")
}

model InspectionRecord {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("inspection_record_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Nullable (PRD §13 Open Question #1 — nomor formal opsional per tipe,
  // BELUM ADA kolom skema utk menandai "tipe ini butuh nomor" — service
  // layer SAAT INI selalu generate utk kesederhanaan, gap TDD §26).
  inspectionRecordNumber String? @map("inspection_record_number") @db.VarChar(50)

  inspectionScheduleId String?             @map("inspection_schedule_id") @db.Uuid
  inspectionSchedule   InspectionSchedule? @relation(fields: [inspectionScheduleId], references: [id])

  // Snapshot versi dipakai saat pelaksanaan (BR-07) — TIDAK PERNAH diubah
  // setelah baris ini dibuat, meski template dapat versi baru kemudian.
  inspectionChecklistTemplateId String                      @map("inspection_checklist_template_id") @db.Uuid
  inspectionChecklistTemplate   InspectionChecklistTemplate @relation(fields: [inspectionChecklistTemplateId], references: [id])

  companyId    String?     @map("company_id") @db.Uuid
  company      Company?    @relation(fields: [companyId], references: [id])
  branchId     String?     @map("branch_id") @db.Uuid
  branch       Branch?     @relation(fields: [branchId], references: [id])
  siteId       String      @map("site_id") @db.Uuid
  site         Site        @relation(fields: [siteId], references: [id])
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  plannedDate DateTime? @map("planned_date") @db.Date
  // PRD §5 tabel tidak menandai NULL, TAPI record status=SCHEDULED belum
  // genuinely "terjadi" — dibuat nullable, diisi saat inspeksi benar2 mulai.
  actualDate  DateTime? @map("actual_date") @db.Timestamptz

  inspectorId String @map("inspector_id") @db.Uuid
  inspector   User   @relation("InspectionRecordInspector", fields: [inspectorId], references: [id])

  status InspectionRecordStatus @default(SCHEDULED)

  overallScore  Decimal?                 @map("overall_score") @db.Decimal(5, 2)
  overallResult InspectionOverallResult? @map("overall_result")

  notes        String? @db.Text
  customFields Json    @default("{}") @map("custom_fields") @db.JsonB

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("InspectionRecordCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("InspectionRecordUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  items    InspectionRecordItem[]
  findings InspectionFinding[]
  scores   InspectionScore[]

  @@unique([tenantId, inspectionRecordNumber])
  @@index([tenantId, status])
  @@index([tenantId, siteId])
  @@index([tenantId, status, plannedDate])
  @@map("inspection_records")
}

model InspectionRecordItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("record_item_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  inspectionRecordId String           @map("inspection_record_id") @db.Uuid
  inspectionRecord   InspectionRecord @relation(fields: [inspectionRecordId], references: [id])

  templateItemId String                          @map("template_item_id") @db.Uuid
  templateItem   InspectionChecklistTemplateItem @relation(fields: [templateItemId], references: [id])

  responseValue String   @map("response_value") @db.VarChar(200)
  scoreObtained Decimal? @map("score_obtained") @db.Decimal(5, 2)
  comment       String?  @db.Text

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("InspectionRecordItemCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("InspectionRecordItemUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  findings InspectionFinding[]

  // Beyond PRD literal — mencegah baris respons duplikat utk item yang
  // sama pada record yang sama (integritas data, bukan BR eksplisit).
  @@unique([inspectionRecordId, templateItemId])
  @@map("inspection_record_items")
}

model InspectionFinding {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("inspection_finding_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  inspectionRecordId String           @map("inspection_record_id") @db.Uuid
  inspectionRecord   InspectionRecord @relation(fields: [inspectionRecordId], references: [id])

  recordItemId String?               @map("record_item_id") @db.Uuid
  recordItem   InspectionRecordItem? @relation(fields: [recordItemId], references: [id])

  title       String @db.VarChar(200)
  description String @db.Text

  severity     InspectionFindingSeverity
  areaLocation String?                   @map("area_location") @db.VarChar(200)
  status       InspectionFindingStatus   @default(OPEN)

  // Modul 24 (Action Tracking, task 7.4) BELUM ADA — bare UUID TANPA FK,
