  fromSite   Site   @relation("AssetTransferFromSite", fields: [fromSiteId], references: [id])
  toSiteId   String @map("to_site_id") @db.Uuid
  toSite     Site   @relation("AssetTransferToSite", fields: [toSiteId], references: [id])

  transferDate DateTime @map("transfer_date") @db.Date

  requestedBy     String? @map("requested_by") @db.Uuid
  requestedByUser User?   @relation("AssetTransferRequestedBy", fields: [requestedBy], references: [id])
  approvedBy      String? @map("approved_by") @db.Uuid
  approvedByUser  User?   @relation("AssetTransferApprovedBy", fields: [approvedBy], references: [id])

  reason String? @db.Text

  // BEYOND literal PRD §5 (tabel ini tidak py kolom audit sama sekali di
  // dokumen sumber) — lihat banner comment blok modul ini.
  createdBy     String   @map("created_by") @db.Uuid
  createdByUser User     @relation("AssetTransferLogCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

