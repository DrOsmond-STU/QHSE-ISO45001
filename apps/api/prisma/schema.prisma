  calibrationWoNo String @map("calibration_wo_no") @db.VarChar(50)

  scheduledDate DateTime? @map("scheduled_date") @db.Date
  dueDate       DateTime  @map("due_date") @db.Date

  // 4 kolom idempotency tetap menggantikan reminder_days_before configurable
