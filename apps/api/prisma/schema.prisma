model IncidentReport {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("incident_report_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  incidentNumber String @map("incident_number") @db.VarChar(50)

  companyId    String?     @map("company_id") @db.Uuid
  company      Company?    @relation(fields: [companyId], references: [id])
  branchId     String?     @map("branch_id") @db.Uuid
  branch       Branch?     @relation(fields: [branchId], references: [id])
  siteId       String      @map("site_id") @db.Uuid
  site         Site        @relation(fields: [siteId], references: [id])
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  classification        IncidentClassification
  initialClassification IncidentClassification @map("initial_classification")
  severityLevel         IncidentSeverityLevel  @map("severity_level")

  incidentDatetime DateTime @map("incident_datetime") @db.Timestamptz
