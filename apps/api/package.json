    "seed:inspection-notification-templates": "ts-node -r ts-node/register/transpile-only prisma/seed-inspection-notification-templates.ts",
    "seed:emergency-response-notification-templates": "ts-node -r ts-node/register/transpile-only prisma/seed-emergency-response-notification-templates.ts",
