model MedicalRecord {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("medical_record_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  employeeUserId String @unique @map("employee_user_id") @db.Uuid
  employeeUser   User   @relation("MedicalRecordEmployee", fields: [employeeUserId], references: [id])

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  siteId    String? @map("site_id") @db.Uuid
  site      Site?   @relation(fields: [siteId], references: [id])

  // [ENCRYPTED] — lihat banner comment blok modul soal alasan seluruh
  // kolom klinis (termasuk yang logisnya bukan string di PRD §5) disimpan
  // sbg ciphertext String.
  bloodTypeEncrypted           String? @map("blood_type_encrypted") @db.Text
  knownAllergiesEncrypted      String? @map("known_allergies_encrypted") @db.Text
  chronicConditionsEncrypted   String? @map("chronic_conditions_encrypted") @db.Text
  currentMedicationsEncrypted  String? @map("current_medications_encrypted") @db.Text
  disabilityStatusEncrypted    String? @map("disability_status_encrypted") @db.Text
  immunizationHistoryEncrypted String? @map("immunization_history_encrypted") @db.Text
  baselineHealthNotesEncrypted String? @map("baseline_health_notes_encrypted") @db.Text

  emergencyMedicalContactName         String? @map("emergency_medical_contact_name") @db.VarChar(150)
  emergencyMedicalContactPhone        String? @map("emergency_medical_contact_phone") @db.VarChar(50)
  emergencyMedicalContactRelationship String? @map("emergency_medical_contact_relationship") @db.VarChar(50)

  consentId String?            @map("consent_id") @db.Uuid
  consent   HealthDataConsent? @relation(fields: [consentId], references: [id])

  lastUpdatedByPractitioner     String? @map("last_updated_by_practitioner") @db.Uuid
  lastUpdatedByPractitionerUser User?   @relation("MedicalRecordLastUpdatedByPractitioner", fields: [lastUpdatedByPractitioner], references: [id])

  recordStatus OhMedicalRecordStatus @default(ACTIVE) @map("record_status")

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("MedicalRecordCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("MedicalRecordUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, companyId])
  @@map("medical_records")
}

