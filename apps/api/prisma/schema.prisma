  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id])

  musterPointCode     String   @map("muster_point_code") @db.VarChar(50)
  musterPointName     String   @map("muster_point_name") @db.VarChar(150)
  locationDescription String?  @map("location_description") @db.Text
  gpsLat              Decimal? @map("gps_lat") @db.Decimal(10, 6)
  gpsLong             Decimal? @map("gps_long") @db.Decimal(10, 6)
