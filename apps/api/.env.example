# Dipakai Prisma CLI (migrate/generate) — role admin, pemilik tabel, hanya lokal dev.
DATABASE_URL="postgresql://postgres@localhost:5432/qhse_dev?schema=public"

# Dipakai runtime NestJS app — role qhse_app, TANPA privilege BYPASSRLS (TDD §5.2).
APP_DATABASE_URL="postgresql://qhse_app:qhse_dev_local@localhost:5432/qhse_dev?schema=public"

PORT=3001

# Task 0.6 — session store, auth-code store, rate-limit counter (TDD §12).
# Lokal dev: Redis portable (.local-redis/, lihat scripts/dev-redis-setup.sh).
REDIS_URL="redis://127.0.0.1:6379"

# Task 0.6 — signing key JWT access token. GANTI nilai ini per environment
# (Vault/KMS di staging/production, SECURITY.md) — nilai contoh ini HANYA
# untuk dev lokal, jangan dipakai di environment lain.
JWT_ACCESS_TOKEN_SECRET="dev-only-change-me-2a9f7c1e4b6d8f0a3c5e7b9d1f3a5c7e"

# Origin frontend yang diizinkan kirim cookie refresh token (CORS credentials).
WEB_ORIGIN="http://localhost:3000"

# Task 0.7 — kunci AES-256-GCM (32 byte, base64) untuk mfa_secret_encrypted.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: Vault/KMS (SECURITY.md), BUKAN nilai statis di .env.
MFA_SECRET_ENCRYPTION_KEY="dev-only-change-me-base64-32-bytes-placeholder="

# Task 5.3 — MASTER key AES-256-GCM (32 byte, base64) utk envelope encryption
# platform/field-encryption (Modul 13 Occupational Health BR-05). Enkripsi
# per-tenant SEBENARNYA pakai data-key TERPISAH yang di-wrap kunci ini
# (tenant_encryption_keys), BUKAN dipakai langsung ke kolom [ENCRYPTED] —
# lihat banner comment field-encryption.service.ts. Placeholder KMS asli
# (AWS KMS/Azure Key Vault/HSM) DITUNDA ke TDD terpisah per PRD Modul 13
# §13 Open Question #5 — WAJIB diganti sebelum tenant PRODUCTION sungguhan
# menyimpan data kesehatan pekerja (lihat README gap Modul 13).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHI_ENCRYPTION_MASTER_KEY="dev-only-change-me-base64-32-bytes-placeholder="

# Task 0.12 — object storage S3-compatible (TDD §11, Master PRD §6.3).
# Lokal dev: MinIO portable (.local-minio/, lihat scripts/dev-minio-setup.sh).
# Production: MinIO on-prem terkelola / AWS S3 (kredensial via Vault/KMS).
OBJECT_STORAGE_ENDPOINT="http://127.0.0.1:9000"
OBJECT_STORAGE_ACCESS_KEY="qhse_app"
OBJECT_STORAGE_SECRET_KEY="qhse_dev_local_minio"
OBJECT_STORAGE_BUCKET="qhse-attachments"
OBJECT_STORAGE_REGION="us-east-1"
