model NotificationPreference {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @map("notification_preference_id") @db.Uuid
  // BEYOND PRD literal (lihat banner comment poin 1 di atas).
  tenantId        String                   @map("tenant_id") @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  eventCategory   String                   @map("event_category") @db.VarChar(100)
  channelCode     NotificationChannelCode  @map("channel_code")
  isEnabled       Boolean                  @default(true) @map("is_enabled")
  deliveryMode    NotificationDeliveryMode @default(REAL_TIME) @map("delivery_mode")
  quietHoursStart DateTime?                @map("quiet_hours_start") @db.Time
  quietHoursEnd   DateTime?                @map("quiet_hours_end") @db.Time

  @@unique([userId, eventCategory, channelCode])
  @@map("notification_preferences")
}

/// Susunan widget dashboard milik SETIAP PENGGUNA (analitik, scorecard).
///
/// `layout` sengaja Json dan bukan tabel widget tersendiri: katalog widget
/// hidup di dalam kode dan berubah setiap kali metrik baru ditambahkan.
/// Menormalkannya berarti setiap penambahan widget menuntut migrasi basis
/// data, padahal isinya semata preferensi tampilan.
///
/// TIDAK dilekati audit_log_trigger — lihat alasannya di banner migrasi
/// 20260803120000.
model DashboardLayout {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("dashboard_layout_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 'analytics' | 'scorecard'. VARCHAR, bukan enum: menambah jenis dashboard
  /// baru tidak boleh menuntut migrasi.
  dashboardKey String @map("dashboard_key") @db.VarChar(50)
  layout       Json   @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, dashboardKey])
  @@index([tenantId])
  @@map("dashboard_layouts")
}

model NotificationLog {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @map("notification_log_id") @db.Uuid
  // BEYOND PRD literal (lihat banner comment poin 1 di atas).
  tenantId          String                  @map("tenant_id") @db.Uuid
  notificationId    String                  @map("notification_id") @db.Uuid
  channelCode       NotificationChannelCode @map("channel_code")
  status            NotificationLogStatus   @default(QUEUED)
  providerMessageId String?                 @map("provider_message_id") @db.VarChar(200)
  providerResponse  Json?                   @map("provider_response") @db.JsonB
  // PRD literal DEFAULT 1 — di sini DEFAULT 0 sengaja (0 = belum ada
  // percobaan sama sekali/masih QUEUED, diincrement tiap percobaan oleh
  // NotificationDeliveryService, bukan "sudah 1x dicoba" padahal belum).
  attemptCount      Int                     @default(0) @map("attempt_count")
  sentAt            DateTime?               @map("sent_at") @db.Timestamptz
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  // Shared-hosting adaptation (REDIS_ENABLED=false, task deployment-adaptation)
  // — dulu SUBJECT/BODY hasil render Handlebars cuma hidup di payload BullMQ
  // (NotificationDeliveryJobPayload), tidak pernah persisten. NotificationPollService
  // (pengganti notification-queue BullMQ consumer) butuh baca ulang baris ini
  // langsung dari DB tanpa job payload — jadi disimpan DI SINI SEKARANG oleh
  // NotificationService.enqueue(), SELALU (bukan cuma saat Redis mati) supaya
  // baris ini juga jadi audit trail lengkap tanpa perlu intip Redis.
  recipientAddress String?   @map("recipient_address") @db.VarChar(320)
  subject          String?   @map("subject") @db.VarChar(250)
  body             String?   @map("body") @db.Text
  // Pengganti exponential backoff BullMQ (NOTIFICATION_BACKOFF_BASE_DELAY_MS)
  // utk mode poll — NotificationPollService TIDAK retry baris yang barusan
  // gagal di tick yang sama/berikutnya, tunggu sampai kolom ini terlampaui.
  // NULL = siap diproses tick manapun (baris baru/belum pernah dicoba).
  nextAttemptAt    DateTime? @map("next_attempt_at") @db.Timestamptz

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@index([status])
  @@map("notification_logs")
}

// ── Task 0.12 — Attachment & Object Storage Service ─────────────────
// Tabel generik `attachments` (Master PRD §11.5) + `scan_status` (TDD §11).
// Kolom `file_url`/`thumbnail_url` — nama PERSIS literal PRD, tapi isinya
// STORAGE KEY (mis. `attachments/{tenantId}/{attachmentId}/{fileName}`),
// BUKAN URL publik statis: presigned GET URL S3 bersifat time-limited
// (expire, TDD §11 "tidak dapat diunduh publik sampai CLEAN" — kalau
// disimpan sebagai URL jadi, URL itu basi begitu presign expire ATAU tidak
// pernah mem-blok akses file INFECTED setelah presign dibuat sekali).
// `ObjectStorageService.getDownloadUrl()` generate presigned URL ON DEMAND
// dari key ini, mengecek scanStatus dulu — itulah enforcement acceptance
// criterion, bukan skema.
//
// Alur (TDD §11): presign() STATELESS (tidak nulis DB, cuma sign URL PUT +
// hitung storage key) → client upload LANGSUNG ke storage → confirm() HEAD
// storage (verifikasi keberadaan + baca size/mime OTORITATIF, bukan
// klaim client) BARU insert baris `attachments` (scanStatus=PENDING_SCAN)
// + enqueue job attachment-scan. Worker scan (stub MalwareScanner, ClamAV
// sungguhan ditunda — gap didokumentasikan TDD §26, pola sama provider
// adapter Notification 0.11) → CLEAN: generate thumbnail (sharp, kalau
// image) + update scanStatus; INFECTED: update scanStatus, file TIDAK
// dihapus otomatis (quarantine/hapus manual di luar cakupan 0.12).
enum AttachmentScanStatus {
  PENDING_SCAN
  CLEAN
  INFECTED
}

model Attachment {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @map("attachment_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  entityType String @map("entity_type") @db.VarChar(50)
  entityId   String @map("entity_id") @db.Uuid

  fileName String @map("file_name") @db.VarChar(255)
  fileUrl  String @map("file_url") @db.VarChar(500) // storage key, lihat banner comment di atas
  fileSize Int    @map("file_size")
  mimeType String @map("mime_type") @db.VarChar(150)

  scanStatus   AttachmentScanStatus @default(PENDING_SCAN) @map("scan_status")
  thumbnailUrl String?              @map("thumbnail_url") @db.VarChar(500) // storage key thumbnail, sama kaidah fileUrl

  uploadedBy     String   @map("uploaded_by") @db.Uuid
  uploadedByUser User     @relation("AttachmentUploadedByUser", fields: [uploadedBy], references: [id])
  uploadedAt     DateTime @default(now()) @map("uploaded_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId, entityType, entityId])
  @@map("attachments")
}

// ── Task 0.13 — Audit Log & Observability ───────────────────────────
// system_audit_logs (Master PRD §11.6) — dipartisi bulanan
// (PARTITION BY RANGE (created_at), TDD §6.1). Prisma tidak mengerti
// partitioning maupun trigger, jadi migration init-nya (lihat
// prisma/migrations/*_init_audit_log_tables) HAND-EDITED dari hasil auto-diff
// `prisma migrate dev --create-only` — pola sama migration RLS lain, hanya
// saja task ini yang pertama perlu meng-edit CREATE TABLE itu sendiri
// (bukan cuma menambah migration RLS terpisah sesudahnya).
//
// tenantId & actorUserId NULLABLE (beda dari pola tabel domain biasa) —
// trigger audit_log_capture() (SECURITY DEFINER, lihat migration) baca
// current_setting('app.current_tenant_id'/'app.current_user_id', true) yang
// BISA NULL untuk operasi lintas-tenant/tanpa aktor manusia (mis. seed
// script lewat role admin, di luar withRls()) — kalau NOT NULL, insert
// semacam itu GAGAL (melanggar constraint) alih-alih menghasilkan entri
// audit "system" yang valid. Kebijakan RLS-nya sendiri (lihat migration
// RLS) TETAP strict equality (BUKAN pola asimetris roles/
// notification_templates 0.8/0.11) — baris tenantId IS NULL SENGAJA tidak
// terlihat siapa pun lewat qhse_app (fail closed); viewer lintas-tenant utk
// Super Admin Platform (Modul 31 — "sysadmin.audit_log.read lintas tenant")
// perlu koneksi admin terpisah, bukan cakupan task ini.
//
// PRIMARY KEY komposit (id, createdAt) — WAJIB utk tabel partisi RANGE
// (createdAt): Postgres mensyaratkan seluruh kolom partition key ikut serta
// di PK/unique constraint manapun (dibuktikan lokal: CREATE TABLE partisi
// tanpa ini ditolak Postgres dengan error eksplisit).
//
// correlationId BEYOND literal Master PRD §11.6 (kolom asli: log_id,
// tenant_id, actor_user_id, action, entity_type, entity_id, before_value,
// after_value, ip_address, user_agent, created_at) — ditambah supaya leg
// "DB" pada correlation ID lintas HTTP→DB→job queue (TDD §15) benar-benar
// bisa ditelusuri baliknya dari satu baris audit ke request/job pemicunya
// (gap didokumentasikan TDD §26).
//
// action diisi APA ADANYA dari TG_OP Postgres (INSERT/UPDATE/DELETE) untuk
// entri otomatis (bukan diterjemahkan ke "CREATE" msk Master PRD — TG_OP
// itulah yang benar-benar terjadi di database), atau bebas oleh pemanggil
// AuditLogService.record() untuk entri semantik manual (APPROVE/EXPORT/
// LOGIN, TDD §6.1) — makanya VARCHAR bebas, bukan enum tertutup (sama
// alasannya dengan entityType: himpunan nilai terbuka lintas 31 modul).
model SystemAuditLog {
  id            String   @default(dbgenerated("gen_random_uuid()")) @map("log_id") @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(20)
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String?  @map("entity_id") @db.Uuid
  beforeValue   Json?    @map("before_value") @db.JsonB
  afterValue    Json?    @map("after_value") @db.JsonB
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  correlationId String?  @map("correlation_id") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([id, createdAt])
  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("system_audit_logs")
}

// Tabel smoke-test murni untuk membuktikan trigger audit_log_capture()
// (task 0.13) benar-benar generik/attachable — pola sama _rls_smoke_test
// (task 0.2/0.3). Diganti tabel domain sungguhan begitu Phase 1+ modul
// domain melekatkan trigger ini ke tabelnya sendiri (lihat
