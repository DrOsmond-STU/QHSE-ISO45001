  workPermitId String     @unique @map("work_permit_id") @db.Uuid
  workPermit   WorkPermit @relation(fields: [workPermitId], references: [id])

  customFields             Json    @default("{}") @map("custom_fields") @db.JsonB
  allMandatoryItemsChecked Boolean @default(false) @map("all_mandatory_items_checked")

  completedBy     String?   @map("completed_by") @db.Uuid
  completedByUser User?     @relation("WorkPermitHazardChecklistCompletedBy", fields: [completedBy], references: [id])
  completedAt     DateTime? @map("completed_at") @db.Timestamptz

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("WorkPermitHazardChecklistCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("WorkPermitHazardChecklistUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@map("work_permit_hazard_checklist")
}

model GasTestResult {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("gas_test_result_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
