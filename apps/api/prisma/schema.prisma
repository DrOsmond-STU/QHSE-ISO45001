  prefix      String               @db.VarChar(20)
  resetPeriod NumberingResetPeriod @map("reset_period")
  scopeLevel  NumberingScopeLevel  @map("scope_level")
  scopeId     String?              @map("scope_id") @db.Uuid

  // Runtime counter state — HANYA ditulis generateNext() di dalam
  // transaksi row-locked (TESTING §6), tidak pernah diedit manual/admin.
  lastSequence  Int     @default(0) @map("last_sequence")
  lastPeriodKey String? @map("last_period_key") @db.VarChar(10)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Task 2.1 — document_categories.default_numbering_config_id (override opsional)
  documentCategories DocumentCategory[]

  // Uniqueness kalau scopeId NULL (scope_level TENANT) ditegakkan lewat
  // partial unique index terpisah di migration (Postgres tidak
  // menganggap dua NULL sama utk composite unique biasa) — lihat
  // migrations/*_enable_rls_numbering_tables.
  @@unique([tenantId, moduleCode, scopeId])
  @@map("numbering_configs")
}

// ── Task 0.11 — Notification Service (infra) ────────────────────────
// 5 tabel PRD Modul 25 §5. Task ini HANYA infra (producer/queue/worker/
// provider adapter/template engine) — inbox in-app UI + halaman preferensi
// (user mengatur channel/quiet hours sendiri) BUKAN cakupan sini, itu task
// 1.7 "Notification Center — domain UI & preferensi", pola sama dengan
// numbering_configs (0.10) yang authoring-nya didelegasikan ke Modul 31.
//
// Provider adapter sendEmail/sendWhatsApp/sendTelegram (lihat
// notification/stub-notification.provider.ts) SEMUA stub yang throw
// eksplisit "provider belum dikonfigurasi" — kredensial sungguhan
// (SMTP/WhatsApp Business API/Telegram Bot API) ada di Modul 30 (API
// Integration) yang belum dikerjakan (provider_config_ref di bawah sudah
// menyediakan kolomnya, FK menyusul begitu Modul 30 ada). Ini BUKAN gap
// yang disembunyikan — dipakai SEBAGAI skenario realistis utk uji jalur
// dead-letter (acceptance criterion task 0.11: "tidak ada test yang
// mengirim pesan sungguhan").
//
// BEYOND PRD Modul 25 §5 literal, gap didokumentasikan TDD §26:
// 1. `notification_preferences` DAN `notification_logs` di draft PRD TIDAK
//    mencantumkan kolom tenant_id (cuma user_id / notification_id FK).
//    Ditambahkan di sini KARENA WAJIB (Master PRD §11 poin 2: tenant_id di
//    setiap tabel domain; generic RLS test TESTING §4 butuh kolom ini utk
//    introspeksi) — tanpa tenant_id, kedua tabel ini TIDAK BISA di-RLS-
//    isolasi sama sekali, pelanggaran prinsip kerja #3 (TASK_INSTRUCTION
//    §1). Kemungkinan besar oversight draft, bukan keputusan sengaja.
// 2. `language` di `notification_templates` PRD sebut ENUM `id`/`en`
//    (lowercase) — dipetakan ke enum Prisma ALL-CAPS (ID/EN) mengikuti
//    konvensi penamaan enum SELURUH schema ini (WorkflowApproverType,
//    NumberingResetPeriod, dst.), bukan penyimpangan semantik.
// 3. `notification_templates` & `notification_channels` butuh partial
//    unique index tambahan (WHERE tenant_id IS NULL) — pola identik
//    `numbering_configs` (0.10): Postgres tidak men-dedup NULL di unique
//    constraint biasa.
enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationChannelCode {
  IN_APP
  EMAIL
  WHATSAPP
  TELEGRAM
}

enum NotificationLogStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum NotificationDeliveryMode {
  REAL_TIME
  DIGEST_DAILY
  DIGEST_WEEKLY
}

enum NotificationLanguage {
  ID
  EN
}

model Notification {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @map("notification_id") @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  recipientUserId String               @map("recipient_user_id") @db.Uuid
  eventType       String               @map("event_type") @db.VarChar(100)
  entityType      String               @map("entity_type") @db.VarChar(50)
  entityId        String               @map("entity_id") @db.Uuid
  title           String               @db.VarChar(200)
  body            String               @db.Text
  priority        NotificationPriority
  isRead          Boolean              @default(false) @map("is_read")
  readAt          DateTime?            @map("read_at") @db.Timestamptz
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz

  logs NotificationLog[]

  @@index([tenantId, recipientUserId, isRead])
  @@map("notifications")
}

model NotificationChannel {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @map("notification_channel_id") @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  channelCode       NotificationChannelCode @map("channel_code")
  isEnabled         Boolean                 @default(true) @map("is_enabled")
  // FK -> integration_configs (Modul 30) BELUM ada tabelnya — UUID mentah
  // tanpa FK, pola sama UserRole.scopeId (0.8) / NumberingConfig.scopeId (0.10).
  providerConfigRef String?                 @map("provider_config_ref") @db.Uuid

  @@unique([tenantId, channelCode])
  @@map("notification_channels")
}

model NotificationTemplate {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @map("notification_template_id") @db.Uuid
  // NULL = template default sistem, tenant dapat override — pola sama
  // roles.tenantId (0.8). Partial unique index utk kasus NULL di migration
  // (lihat banner comment di atas poin 3).
  tenantId        String?                 @map("tenant_id") @db.Uuid
  eventType       String                  @map("event_type") @db.VarChar(100)
  channelCode     NotificationChannelCode @map("channel_code")
  language        NotificationLanguage
  subjectTemplate String?                 @map("subject_template") @db.VarChar(250)
  bodyTemplate    String                  @map("body_template") @db.Text
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, eventType, channelCode, language])
  @@map("notification_templates")
