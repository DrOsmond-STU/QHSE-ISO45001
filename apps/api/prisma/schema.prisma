  accreditationScope               Json?     @map("accreditation_scope")
  accreditationValidUntil          DateTime? @map("accreditation_valid_until") @db.Date
  // §8 baris 5 (H-60) — ditemukan BUTUH kolom idempotency terpisah baru saat
  // mendesain calibration-due-scan (task 288), BUKAN sejak migrasi awal
  // tabel (task 282) — pola PERSIS maintenance_schedules reminder columns
