// Task 6.3 (Modul 17 Contractor Management), modul DOMAIN KEDUA PULUH SATU.
// 7 tabel baru + retroaktif FK sungguhan work_permits.contractorCompanyId
// (3.3) & incident_reports.contractorCompanyId (3.5), sebelumnya bare UUID
// TANPA FK krn modul ini belum ada saat itu — lihat comment di kedua field
// itu sendiri. Deviasi PRD dicatat di sini (gap TDD §26 detail lengkap):
// (1) PRD §5/§6 BR-02 sebut "work_permits.requester_type (termasuk nilai
//     CONTRACTOR)" — kolom requester_type SUNGGUHAN TIDAK PERNAH ada di
//     work_permits (3.3, hanya requesterId->User + contractorCompanyId
//     nullable) — BR-02 diwujudkan via "contractorCompanyId TERISI" sbg
//     proxy, bukan enum requester_type yang tidak pernah ditulis.
// (2) PRD §6 BR-04 sebut "tenant.industry_type = OIL_GAS" — kolom
//     industry_type SUNGGUHAN TIDAK ADA di tenants (1.1); klasifikasi
//     industri SEBENARNYA lewat tenants.industryTemplateId ->
//     industry_templates.code (seed-industry-templates.ts SUDAH py baris
//     code="OIL_GAS" sejak task 1.1) — BR-04 dibaca lewat relasi ini.
// (3) contractor_document_compliance TIDAK PUNYA baris §3 RBAC literal
//     terpisah dari contractor_prequalification_documents — KEDUANYA
//     dipetakan kode contractor.document.* yang sama (§3 PRD tidak
//     memisahkan "dokumen prakualifikasi" vs "dokumen kepatuhan
//     berkelanjutan" jadi entity RBAC berbeda), lihat seed-rbac-baseline.ts.
// (4) contractor_workers.status (ENUM ACTIVE/DEMOBILIZED/SUSPENDED/
//     BLACKLISTED, PRD §5 literal) TIDAK PUNYA nilai utk "baru didaftarkan,
//     belum diinduksi" (§4.3 poin 2-3 implikasikan momen ini genuinely ada)
//     — SUSPENDED dipakai sbg placeholder terdekat sampai BR-03 (site
//     induction) terpenuhi lalu ditransisi ACTIVE, gap TDD §26.
model Contractor {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("contractor_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  contractorName String         @map("contractor_name") @db.VarChar(200)
  contractorType ContractorType @map("contractor_type")

  businessRegistrationNo String? @map("business_registration_no") @db.VarChar(100)
  businessLicenseType    String? @map("business_license_type") @db.VarChar(100)
  taxIdNpwp              String? @map("tax_id_npwp") @db.VarChar(30)
  address                String? @db.Text
  city                   String? @db.VarChar(100)
  province               String? @db.VarChar(100)
  contactPersonName      String? @map("contact_person_name") @db.VarChar(150)
  contactPersonPhone     String? @map("contact_person_phone") @db.VarChar(30)
  contactPersonEmail     String? @map("contact_person_email") @db.VarChar(150)

  contractorCategory ContractorCategory @map("contractor_category")

  parentContractorId String?      @map("parent_contractor_id") @db.Uuid
  parentContractor   Contractor?  @relation("ContractorParent", fields: [parentContractorId], references: [id])
  subContractors     Contractor[] @relation("ContractorParent")

  overallRiskRating ContractorRiskRating @map("overall_risk_rating")
  status            ContractorStatus     @default(REGISTERED)
  registeredAt      DateTime?            @map("registered_at") @db.Date

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("ContractorCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("ContractorUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  prequalifications      ContractorPrequalification[]
  documentCompliances    ContractorDocumentCompliance[]
  workers                ContractorWorker[]
  projectAssignments     ContractorProjectAssignment[]
  performanceEvaluations ContractorPerformanceEvaluation[]
  workPermits            WorkPermit[]
  incidentReports        IncidentReport[]

  @@index([tenantId, status])
  @@map("contractors")
}

model ContractorPrequalification {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("prequalification_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  contractorId String     @map("contractor_id") @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id])

  prequalificationNo   String                         @map("prequalification_no") @db.VarChar(50)
  prequalificationType ContractorPrequalificationType @map("prequalification_type")

  scopeOfWork              String?  @map("scope_of_work") @db.Text
  technicalCapabilityScore Decimal? @map("technical_capability_score") @db.Decimal
  hseCapabilityScore       Decimal? @map("hse_capability_score") @db.Decimal
  financialCapabilityScore Decimal? @map("financial_capability_score") @db.Decimal
  overallScore             Decimal? @map("overall_score") @db.Decimal
  minPassingScore          Decimal? @map("min_passing_score") @db.Decimal

  result ContractorPrequalificationResult @default(PENDING)

  validFrom  DateTime? @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date

  evaluatedBy     String?   @map("evaluated_by") @db.Uuid
  evaluatedByUser User?     @relation("ContractorPrequalificationEvaluatedBy", fields: [evaluatedBy], references: [id])
  evaluationDate  DateTime? @map("evaluation_date") @db.Date

  workflowInstanceId String?           @unique @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  status ContractorPrequalificationStatus @default(DRAFT)

  // BEYOND kolom literal PRD §5 — idempotency scan job §8 baris 3 ("valid_until
  // mendekati H-60"), ditambah SUSULAN saat mendesain contractor-due-scan
  // (task 303), pola PERSIS Calibration accreditationExpiryWarningSentAt/
  // Asset dueSoonReminderSentAt (6.1/6.2, keduanya juga follow-up migration).
  renewalReminderSentAt DateTime? @map("renewal_reminder_sent_at") @db.Timestamptz

  createdBy     String    @map("created_by") @db.Uuid
