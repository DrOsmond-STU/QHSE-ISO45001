  roleId          String   @map("role_id") @db.Uuid
  permissionId    String   @map("permission_id") @db.Uuid
  scopeConstraint Json?    @map("scope_constraint") @db.JsonB // reserved — TIDAK dievaluasi PermissionService 0.8
  createdBy       String?  @map("created_by") @db.Uuid // nullable — baris system diseed platform, bukan user
  createdByUser   User?    @relation("RolePermissionCreatedByUser", fields: [createdBy], references: [id])
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @map("user_role_id") @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  roleId    String         @map("role_id") @db.Uuid
  scopeType ScopeType      @map("scope_type")
  scopeId   String?        @map("scope_id") @db.Uuid // NULL iff scopeType=TENANT; polymorphic, TETAP tanpa FK (lihat banner comment di atas)
  validFrom DateTime       @default(now()) @map("valid_from") @db.Date
  validTo   DateTime?      @map("valid_to") @db.Date
  status    UserRoleStatus @default(ACTIVE)

  // "audit standar" (PRD Modul 02 §5) ditambahkan task 1.3 — 0.8 hanya
  // punya createdAt/updatedAt (subset minimal, lihat banner comment blok
  // ini). Nullable: assignment via test helper/bootstrap (pola sama
  // Role.createdBy) tidak selalu punya aktor manusia.
  createdBy     String?   @map("created_by") @db.Uuid
  createdByUser User?     @relation("UserRoleCreatedByUser", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String?   @map("updated_by") @db.Uuid
  updatedByUser User?     @relation("UserRoleUpdatedByUser", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  role Role @relation(fields: [roleId], references: [id])
  user User @relation("UserRoleUser", fields: [userId], references: [id])

  @@index([userId])
  @@map("user_roles")
}

// ── Task 1.3 — SSO mapping (Modul 02 §5) ────────────────────────────
// HANYA pemetaan identitas user<->IdP eksternal — konfigurasi teknis
// koneksi IdP (metadata URL, sertifikat, client secret) ada di
// integration_configs milik Modul 30 (belum ada tabelnya, module itu belum
// dikerjakan). Handshake SAML/OIDC sungguhan JUGA di luar cakupan task ini
// — tabel + service resolusi mapping saja, pola sama seluruh task 1.1/1.2
// (tabel+service, belum ada endpoint HTTP).

enum SsoIdpProvider {
  AZURE_AD
  GOOGLE_WORKSPACE
  SAML_GENERIC
  OIDC_GENERIC
}

enum SsoMappingStatus {
  ACTIVE
  INACTIVE
}

model SsoMapping {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("sso_mapping_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // NULL sampai user pertama kali berhasil login/di-provision (PRD §5) —
  // mapping bisa dibuat Tenant Admin LEBIH DULU (pre-provisioning) sebelum
  // user itu sendiri pernah login sama sekali.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation("SsoMappingUser", fields: [userId], references: [id])

  idpProvider         SsoIdpProvider @map("idp_provider")
  idpTenantIdentifier String?        @map("idp_tenant_identifier") @db.VarChar(255)
  externalSubjectId   String         @map("external_subject_id") @db.VarChar(255)
  externalEmail       String?        @map("external_email") @db.VarChar(150)

  // PRD §13 Open Question #4 SENGAJA direkomendasikan default FALSE
  // ("mempercepat onboarding tapi berisiko user tak sah otomatis dapat
  // akses bila domain SSO salah konfigurasi") — bukan open question yang
  // butuh keputusan baru, PRD sudah condong ke satu jawaban, diikuti apa
  // adanya.
  autoProvision Boolean @default(false) @map("auto_provision")

  defaultRoleIdOnProvision String? @map("default_role_id_on_provision") @db.Uuid
  defaultRoleOnProvision   Role?   @relation("SsoMappingDefaultRole", fields: [defaultRoleIdOnProvision], references: [id])

  status         SsoMappingStatus @default(ACTIVE)
  lastSsoLoginAt DateTime?        @map("last_sso_login_at") @db.Timestamptz

  createdBy     String?   @map("created_by") @db.Uuid
  createdByUser User?     @relation("SsoMappingCreatedByUser", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String?   @map("updated_by") @db.Uuid
  updatedByUser User?     @relation("SsoMappingUpdatedByUser", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  // Satu (tenant, IdP, external subject) cuma boleh memetakan ke SATU user.
  @@unique([tenantId, idpProvider, externalSubjectId])
  @@index([tenantId, status])
  @@index([userId])
  @@map("sso_mappings")
}

// ── Task 1.4 — Delegation of Authority (Modul 02 §5) ────────────────
// Master record organisasional/HR-driven ("mengapa dan berapa lama
// seseorang didelegasikan") — BEDA dari workflow_delegations (platform,
// lapisan eksekusi teknis yang benar-benar dikonsumsi Workflow Engine,
// lihat model WorkflowDelegation di atas). status ACTIVE memicu
// pembuatan/aktivasi otomatis WorkflowDelegation terkait (BR-08,
// DelegationOfAuthorityService/delegation-scan job) — mencegah admin
// mengonfigurasi delegasi dua kali terpisah.

enum DelegationReason {
  ANNUAL_LEAVE
  SICK_LEAVE
  BUSINESS_TRIP
  RESIGNATION_TRANSITION
  OTHER
}

enum DelegationStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  CANCELLED
  REVOKED
}

model DelegationOfAuthority {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("delegation_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  delegatorUserId String @map("delegator_user_id") @db.Uuid
  delegatorUser   User   @relation("DelegationOfAuthorityDelegator", fields: [delegatorUserId], references: [id])
  delegateUserId  String @map("delegate_user_id") @db.Uuid
  delegateUser    User   @relation("DelegationOfAuthorityDelegate", fields: [delegateUserId], references: [id])

  // NULL = seluruh scope yang dipegang delegator (PRD §5 literal).
  scopeType ScopeType? @map("scope_type")
  scopeId   String?    @map("scope_id") @db.Uuid
  // NULL = seluruh role delegator (PRD §5 literal).
  roleId    String?    @map("role_id") @db.Uuid
  role      Role?      @relation(fields: [roleId], references: [id])

  reason   DelegationReason @default(OTHER)
  dateFrom DateTime         @map("date_from") @db.Date
  dateTo   DateTime         @map("date_to") @db.Date
  status   DelegationStatus @default(SCHEDULED)

  // Diisi kalau kebijakan tenant mewajibkan approval atasan (PRD §4.3 poin
  // 2) — diset LANGSUNG oleh DelegationOfAuthorityService, BUKAN lewat
  // Workflow Engine formal (gating opsional itu butuh mekanisme konfigurasi
  // per-tenant yang belum ada, Modul 31/task 1.5 — pola sama site-closure
  // workflow yang JUGA "opsional" dan JUGA tidak dibangun formal di task
  // 1.1, gap TDD §26).
  approvedBy     String? @map("approved_by") @db.Uuid
  approvedByUser User?   @relation("DelegationOfAuthorityApprovedBy", fields: [approvedBy], references: [id])

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("DelegationOfAuthorityCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("DelegationOfAuthorityUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, delegatorUserId, status])
  @@index([tenantId, status, dateFrom, dateTo])
  @@map("delegation_of_authority")
}

// ── Task 0.9 — Workflow Engine (core) ───────────────────────────────
// State machine berbasis konfigurasi (TDD §9, Master PRD §9). Semua 5 tabel
// punya tenant_id sendiri (bukan diturunkan lewat join) — pola sama dengan
// role_permissions task 0.8, demi RLS-policy sederhana. workflow_delegations
// TIDAK dibangun di sini (tugas task 1.4) — workflow_tasks.delegatedTo/
// DELEGATED sudah jadi seam-nya.

enum WorkflowApproverType {
  SPECIFIC_USER
  ROLE_IN_SCOPE
  REPORTING_LINE
  // Task 2.1 (DMS) — approver adalah SATU user spesifik yang terikat ke
  // ENTITAS yang sedang diproses (mis. document_versions Stage 1 "Document
  // Owner" = documents.owner_user_id), BUKAN role tenant-wide (ROLE_IN_SCOPE)
  // maupun user tetap yang sama di semua instance (SPECIFIC_USER — approver
  // BEDA per document, workflow_stages baris tunggal tidak bisa
  // menyimpannya). User id-nya dibaca dari workflow_instances.context_data
  // pada key TETAP "contextUserId" (lihat banner comment
  // ApproverResolutionService.resolveNaturalApprovers) — caller
  // (DocumentVersionService.submitForApproval) yang mengisi contextData saat
  // startInstance(). Convention key generik (bukan "ownerUserId") supaya
  // modul Phase 3+ lain dgn kebutuhan serupa bisa reuse tanpa enum value baru.
  CONTEXT_USER
}

enum WorkflowEscalationAction {
  NOTIFY_SUPERIOR
  AUTO_ESCALATE
  NONE
}

enum WorkflowParallelCompletionRule {
  ALL_APPROVE
  ANY_ONE_APPROVE
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkflowTaskStatus {
  PENDING
  APPROVED
  REJECTED
  DELEGATED
}

enum WorkflowTaskAction {
  APPROVE
  REJECT
  RETURN
}

model WorkflowDefinition {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @map("workflow_definition_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  moduleCode String   @map("module_code") @db.VarChar(50)
  name       String   @db.VarChar(150)
  isActive   Boolean  @default(true) @map("is_active")
  // Perubahan definisi = versi baru; instance berjalan tetap pakai versi
  // lama (PRD §9.2) — evaluateTransition() SELALU resolve lewat FK instance
  // -> definition version yang di-pin saat startInstance(), tidak pernah
  // "definisi aktif tenant" secara langsung.
  version    Int      @default(1)
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedBy  String?  @map("updated_by") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  stages      WorkflowStage[]
  transitions WorkflowTransition[]
  instances   WorkflowInstance[]

  @@index([tenantId, moduleCode, isActive])
  @@map("workflow_definitions")
}

model WorkflowStage {
  id                     String                          @id @default(dbgenerated("gen_random_uuid()")) @map("stage_id") @db.Uuid
  tenantId               String                          @map("tenant_id") @db.Uuid
  workflowDefinitionId   String                          @map("workflow_definition_id") @db.Uuid
  sequenceNo             Int                             @map("sequence_no")
  stageName              String                          @map("stage_name") @db.VarChar(100)
  approverType           WorkflowApproverType            @map("approver_type")
  approverRoleId         String?                         @map("approver_role_id") @db.Uuid
  // Beyond PRD §9 literal — SPECIFIC_USER butuh target literal; prose PRD
  // mengimplikasikannya tapi tidak menunjukkan kolom.
  approverUserId         String?                         @map("approver_user_id") @db.Uuid
  slaHours               Int                             @map("sla_hours")
  escalationAction       WorkflowEscalationAction        @map("escalation_action")
  // Beyond PRD §9 literal — target role AUTO_ESCALATE ("assign ke role
  // scope lebih tinggi", TDD §9 prose tanpa nama kolom). Nullable: kalau
  // kosong, AUTO_ESCALATE tetap set escalatedAt + emit event TAPI tidak
  // reassign (graceful degrade, bukan no-op diam-diam).
  escalationRoleId       String?                         @map("escalation_role_id") @db.Uuid
  allowDelegation        Boolean                         @default(false) @map("allow_delegation")
  isParallelGroup        Boolean                         @default(false) @map("is_parallel_group")
  // TDD §9/§26 — documented gap: belum ada di Master PRD §9.1 ("didokumentasikan
  // saat revisi berikutnya"). Ditambah sekarang, pola sama dgn
  // users.failedLoginAttempts (task 0.6).
  parallelCompletionRule WorkflowParallelCompletionRule? @default(ALL_APPROVE) @map("parallel_completion_rule")
  createdAt              DateTime                        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                        @updatedAt @map("updated_at") @db.Timestamptz

  workflowDefinition   WorkflowDefinition   @relation(fields: [workflowDefinitionId], references: [id])
  approverRole         Role?                @relation("WorkflowStageApproverRole", fields: [approverRoleId], references: [id])
  escalationRole       Role?                @relation("WorkflowStageEscalationRole", fields: [escalationRoleId], references: [id])
  approverUser         User?                @relation("WorkflowStageApproverUser", fields: [approverUserId], references: [id])
  tasks                WorkflowTask[]
  transitionsFrom      WorkflowTransition[] @relation("TransitionFromStage")
  transitionsTo        WorkflowTransition[] @relation("TransitionToStage")
  instancesAtThisStage WorkflowInstance[]

  @@unique([workflowDefinitionId, sequenceNo])
  @@map("workflow_stages")
}

model WorkflowTransition {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @map("transition_id") @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  workflowDefinitionId String                  @map("workflow_definition_id") @db.Uuid
  fromStageId          String                  @map("from_stage_id") @db.Uuid
  toStageId            String?                 @map("to_stage_id") @db.Uuid // NULL = terminal
  triggerAction        WorkflowTaskAction      @map("trigger_action")
  condition            Json?                   @db.JsonB // JSON Logic AST (TDD §9); NULL = unconditional match
  priority             Int                     @default(0) // lebih kecil dievaluasi duluan; match pertama menang
  resultStatus         WorkflowInstanceStatus? @map("result_status") // dipakai hanya kalau toStageId NULL
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  fromStage          WorkflowStage      @relation("TransitionFromStage", fields: [fromStageId], references: [id])
  toStage            WorkflowStage?     @relation("TransitionToStage", fields: [toStageId], references: [id])

  @@index([fromStageId, triggerAction, priority])
  @@map("workflow_transitions")
}

model WorkflowInstance {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @map("instance_id") @db.Uuid
  tenantId             String                 @map("tenant_id") @db.Uuid
  workflowDefinitionId String                 @map("workflow_definition_id") @db.Uuid
  // Polymorphic, TANPA FK (pola sama dgn system_audit_logs) — modul domain
  // tidak buat tabel workflow sendiri, cukup referensi ini (PRD §9.2).
  entityType           String                 @map("entity_type") @db.VarChar(50)
  entityId             String                 @map("entity_id") @db.Uuid
  currentStageId       String?                @map("current_stage_id") @db.Uuid
  status               WorkflowInstanceStatus @default(IN_PROGRESS)
  // Beyond PRD literal — evaluateTransition(instanceId) (TDD §9) cuma terima
  // SATU parameter, jadi context JSON Logic harus nempel di instance, bukan
  // di-pass per-panggilan. Snapshot yang caller supply di startInstance()
  // (bisa di-refresh sebelum actOnTask kalau field relevan berubah) — engine
  // TIDAK fetch ulang data domain sendiri (jaga batas modular monolith).
  contextData          Json?                  @map("context_data") @db.JsonB
  startedAt            DateTime               @default(now()) @map("started_at") @db.Timestamptz
  completedAt          DateTime?              @map("completed_at") @db.Timestamptz

  workflowDefinition              WorkflowDefinition               @relation(fields: [workflowDefinitionId], references: [id])
  currentStage                    WorkflowStage?                   @relation(fields: [currentStageId], references: [id])
  tasks                           WorkflowTask[]
  // Task 2.1 — FK LANGSUNG (domain->platform, arah yang diizinkan; lihat
  // banner comment DocumentVersion.workflowInstanceId), BEDA dari entityId
  // polymorphic di atas yang justru TIDAK BOLEH jadi FK ke domain manapun.
  documentVersion                 DocumentVersion?
  complianceEvaluation            ComplianceEvaluation?
  hiraAssessment                  HiraAssessment?
  jsaRecord                       JsaRecord?
  hiradcRecord                    HiradcRecord?
  workPermit                      WorkPermit?
  workPermitApprovals             WorkPermitApproval[]
  workPermitExtension             WorkPermitExtension?
  incidentInvestigation           IncidentInvestigation?
  emergencyResponsePlan           EmergencyResponsePlan?
  auditProgram                    AuditProgram?
  audit                           Audit?
  auditReport                     AuditReport?
  capaRegister                    CapaRegister?
  capaApproval                    CapaApproval?
  ncrRecord                       NcrRecord?
  customerComplaint               CustomerComplaint?
  qualityInspectionDeviation      QualityInspection?
  supplierQualityRecord           SupplierQualityRecord?
  environmentalAspectImpact       EnvironmentalAspectImpact?
  properSelfAssessment            ProperSelfAssessment?
  occupationalDiseaseCase         OccupationalDiseaseCase?
  calibrationCertificate          CalibrationCertificate?
  contractorPrequalification      ContractorPrequalification?
  contractorPerformanceEvaluation ContractorPerformanceEvaluation?

  @@index([tenantId, entityType, entityId])
  @@map("workflow_instances")
}

model WorkflowTask {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @map("task_id") @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  instanceId  String             @map("instance_id") @db.Uuid
  stageId     String             @map("stage_id") @db.Uuid
  assignedTo  String             @map("assigned_to") @db.Uuid
  status      WorkflowTaskStatus @default(PENDING)
  comment     String?            @db.Text
  actedAt     DateTime?          @map("acted_at") @db.Timestamptz
  actedBy     String?            @map("acted_by") @db.Uuid
  delegatedTo String?            @map("delegated_to") @db.Uuid // ditulis task 1.4 saja; kolom sudah ada sesuai PRD prose
  // Natural key idempotency utk workflow-sla-scan (TDD §13.2) — begitu
  // eskalasi terjadi, escalatedAt di-set supaya scan 15-menit berikutnya
  // TIDAK memicu ulang notifikasi/reassignment yang sama.
  escalatedAt DateTime?          @map("escalated_at") @db.Timestamptz
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  instance        WorkflowInstance @relation(fields: [instanceId], references: [id])
  stage           WorkflowStage    @relation(fields: [stageId], references: [id])
  assignedUser    User             @relation("WorkflowTaskAssignedUser", fields: [assignedTo], references: [id])
  actedByUser     User?            @relation("WorkflowTaskActedByUser", fields: [actedBy], references: [id])
  delegatedToUser User?            @relation("WorkflowTaskDelegatedToUser", fields: [delegatedTo], references: [id])

  @@index([instanceId])
  @@index([status, escalatedAt])
  @@map("workflow_tasks")
}

// Task 1.4 — Master PRD §9.1 literal: "pendelegasian approval sementara
// (mis. cuti), delegator_user_id, delegate_user_id, date_from, date_to,
// scope." scope tunggal PRD dipecah scopeType+scopeId+roleId supaya BENTUK
// datanya identik dengan delegation_of_authority (Modul 02 §5,
// modules/domains/user-role/) — BR-08 auto-provisioning jadi salin field
// langsung, bukan transformasi bentuk. sourceDelegationOfAuthorityId UUID
// mentah TANPA FK (platform TIDAK BOLEH FK ke tabel domain, arah modular
// monolith terbalik — pola sama entityId polymorphic di workflow_instances)
// — NULL kalau baris ini dibuat AD-HOC langsung (PRD §4.3: "tenant tetap
// dapat membuat workflow_delegations ad-hoc tanpa delegation_of_authority").
model WorkflowDelegation {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @map("delegation_id") @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  delegatorUserId String @map("delegator_user_id") @db.Uuid
  delegatorUser   User   @relation("WorkflowDelegationDelegator", fields: [delegatorUserId], references: [id])
  delegateUserId  String @map("delegate_user_id") @db.Uuid
  delegateUser    User   @relation("WorkflowDelegationDelegate", fields: [delegateUserId], references: [id])

  // NULL roleId = berlaku utk SEMUA role yang dipegang delegator (PRD §5
  // delegation_of_authority: "NULL = seluruh role delegator").
  roleId    String?    @map("role_id") @db.Uuid
  role      Role?      @relation(fields: [roleId], references: [id])
  scopeType ScopeType? @map("scope_type")
  scopeId   String?    @map("scope_id") @db.Uuid

  dateFrom DateTime @map("date_from") @db.Date
  dateTo   DateTime @map("date_to") @db.Date
  isActive Boolean  @default(true) @map("is_active")

  sourceDelegationOfAuthorityId String? @map("source_delegation_of_authority_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId, delegatorUserId, isActive])
  @@index([sourceDelegationOfAuthorityId])
  @@map("workflow_delegations")
}

// ── Task 0.10 — Numbering Service ───────────────────────────────────
// numbering_configs (Master PRD §10). Field pertama tiga (tenantId,
// moduleCode, pattern/prefix/resetPeriod/scopeLevel) persis literal PRD.
// scopeId & lastPeriodKey: BEYOND PRD literal, gap didokumentasikan TDD
// §26 poin 8 (pola sama dgn parallel_completion_rule task 0.9) — PRD cuma
// sebut SATU last_sequence per (tenant,module_code), tapi itu tidak bisa
// benar kalau scope_level=SITE/COMPANY (tiap site butuh counter sendiri)
// atau reset_period=YEARLY/MONTHLY (counter harus tahu "periode mana"
// yang sedang berjalan untuk deteksi rollover) — satu counter dibagi
// SEMUA site/company/periode sekaligus akan menghasilkan nomor bentrok
// antar site atau antar periode, persis yang seharusnya dicegah row lock.
// scopeId: UUID mentah TANPA FK PERMANEN (polymorphic — sama alasan
// UserRole.scopeId task 0.8, lihat banner comment-nya), NULL = scope_level TENANT.
// lastPeriodKey: "2026" (YEARLY) / "2026-07" (MONTHLY) / NULL (NEVER) —
// dibandingkan tiap generateNext() untuk deteksi rollover; rollover
// me-reset lastSequence di baris YANG SAMA (bukan bikin baris baru per
// periode) supaya query lookup tetap satu row per (tenant,module,scope).
//
// Authoring config (CRUD numbering_configs oleh Tenant Admin) BUKAN
// cakupan task 0.10 — itu Modul 31/System Administration
// (prd/modules/31-system-administration.md §5: "UI konfigurasi numbering
// adalah antarmuka CRUD atas tabel tersebut"). Task 0.10 hanya
// generateNext() runtime; baris config di-seed langsung lewat Prisma di
// test, pola sama dgn workflow_definitions (0.9) yang juga belum punya
// "builder service" sendiri.
enum NumberingResetPeriod {
  YEARLY
  MONTHLY
  NEVER
}

enum NumberingScopeLevel {
  TENANT
  COMPANY
  SITE
}

model NumberingConfig {
