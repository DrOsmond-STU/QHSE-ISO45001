// Prisma schema — TDD §5.2, §6.1. DATABASE_URL dipakai untuk migrate (role admin,
// pemilik tabel). Runtime app connect via APP_DATABASE_URL (role qhse_app, TANPA
// BYPASSRLS) — lihat src/platform/tenancy/prisma.service.ts.

generator client {
  provider = "prisma-client-js"

  // Target Linux di sini ada UNTUK DEPLOYMENT SHARED HOSTING, bukan untuk
  // pengembangan lokal. Alasannya konkret: `prisma generate` untuk skema 162
  // model ini butuh lebih dari 1 GB memori, sedangkan paket hosting tujuan
  // membatasi memori fisik akun tepat 1 GB — prosesnya DIBUNUH SIGKILL setelah
  // 16 detik, dan itu bukan dugaan (diukur: ulimit cpu/memori unlimited, host
  // punya 36 GB bebas, sinyal 9 bukan 24, jadi yang membunuh adalah batas LVE
  // CloudLinux). Karena generate tidak mungkin dijalankan DI server, hasilnya
  // dibangun di sini dan dikirim bersama repositori; supaya berguna di sana,
  // engine Linux-nya harus ikut dihasilkan sekarang.
  //
  // "native" tetap ada supaya pengembangan lokal (Windows/macOS/Linux) tidak
  // berubah sama sekali. Menambah target hanya menambah unduhan engine saat
  // generate; tidak ada perilaku runtime yang berubah.
  //
  // KENAPA debian, padahal paket servernya bernama el10 (RHEL/AlmaLinux 10):
  // karena yang menentukan adalah deteksi runtime Prisma di mesin itu sendiri,
  // bukan penamaan paket. Percobaan dengan `rhel-openssl-3.0.x` gagal dan
  // Prisma menyebut targetnya sendiri:
  //   "could not locate the Query Engine for runtime debian-openssl-3.0.x"
  // Jadi nilai ini berasal dari pesan galat di server, bukan dari kesimpulan
  // atas nama distribusi — yang ternyata menyesatkan di CloudLinux.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabel smoke-test murni untuk membuktikan mekanisme RLS + tenant context
// (task 0.2/0.3) berjalan nyata. Diganti tabel domain sungguhan (Modul 01
// `tenants`, dst.) begitu Phase 1 TASK_INSTRUCTION.md dimulai.
model RlsSmokeTest {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  label    String

  @@map("_rls_smoke_test")
}

// ── Task 0.6 — Autentikasi OIDC + sesi ──────────────────────────────
// Kolom subset auth-critical (task 0.6) diperluas task 1.3 Modul 02 lewat
// ALTER TABLE ADD COLUMN (expand, bukan tabel baru — DEPLOYMENT.md §6).
// tenant_id: FK ke `tenants` ditambahkan task 1.1 begitu tabel itu ada.

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserType {
  INTERNAL_EMPLOYEE
  CONTRACTOR
  VISITOR
  PLATFORM_ADMIN
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid

  // BR-11 (PRD Modul 02 §6) — NULL HANYA utk user_type=PLATFORM_ADMIN (Super
  // Admin Platform sungguhan, lintas-tenant). NOT NULL sejak task 0.6-1.2,
  // dilonggarkan task 1.3 sesuai literal PRD. Kebijakan RLS
  // tenant_isolation_policy TETAP strict (tenant_id = current_setting(...))
  // — SENGAJA TIDAK diberi kebijakan asimetris seperti roles/role_permissions
  // (0.8, OR tenant_id IS NULL) karena baris PLATFORM_ADMIN semestinya TIDAK
  // terlihat dari konteks tenant manapun (bukan "berlaku lintas tenant"
  // seperti system role, tapi "bukan milik tenant manapun sama sekali") —
  // diakses lewat koneksi admin terpisah kalau dibutuhkan, pola sama
  // audit-log-partition-maintenance (0.13). Bootstrap sysadmin
  // (seed-auth-dev.ts, 0.7) TETAP memakai pola lama (tenant_id terisi, role
  // SUPER_ADMIN_PLATFORM discope TENANT) — belum dimigrasikan ke
  // PLATFORM_ADMIN/tenant_id=NULL sungguhan, dan alur login (platform/auth/*)
  // TIDAK diubah task ini untuk menerima user tanpa tenant — hanya
  // KESIAPAN skema yang dibangun (gap TDD §26).
  tenantId String? @map("tenant_id") @db.Uuid
  // onDelete: Restrict eksplisit (BUKAN default SET NULL yang Prisma infer
  // utk FK opsional) — tenant_id=NULL punya arti KHUSUS (BR-11,
  // PLATFORM_ADMIN); lihat komentar tenantId di atas.
  tenant   Tenant? @relation("UserTenant", fields: [tenantId], references: [id], onDelete: Restrict)

  employeeId  String?  @map("employee_id") @db.VarChar(50) // BR-09 — unik per tenant kalau diisi
  email       String   @db.VarChar(150)
  username    String?  @db.VarChar(100)
  fullName    String   @map("full_name") @db.VarChar(150)
  phoneNumber String?  @map("phone_number") @db.VarChar(30)
  userType    UserType @default(INTERNAL_EMPLOYEE) @map("user_type")

  departmentId String?            @map("department_id") @db.Uuid
  department   Department?        @relation("UserDepartment", fields: [departmentId], references: [id])
  siteId       String?            @map("site_id") @db.Uuid
  site         Site?              @relation("UserSite", fields: [siteId], references: [id])
  positionId   String?            @map("position_id") @db.Uuid
  position     OrganizationChart? @relation("UserPosition", fields: [positionId], references: [id])
  jobTitle     String?            @map("job_title") @db.VarChar(150)

  // Sumber utama resolusi REPORTING_LINE Workflow Engine (PRD Modul 02 §5) —
  // independen dari organization_charts.reportsToPositionId (posisi
  // struktural formal vs pemegang jabatan aktual, lihat PRD Modul 01 §4.3).
  reportingToUserId String? @map("reporting_to_user_id") @db.Uuid
  reportingToUser   User?   @relation("UserReportingLine", fields: [reportingToUserId], references: [id])
  directReports     User[]  @relation("UserReportingLine")

  status        UserStatus @default(INVITED)
  invitedAt     DateTime?  @map("invited_at") @db.Timestamptz
  activatedAt   DateTime?  @map("activated_at") @db.Timestamptz
  suspendedAt   DateTime?  @map("suspended_at") @db.Timestamptz
  deactivatedAt DateTime?  @map("deactivated_at") @db.Timestamptz

  passwordHash       String? @map("password_hash") @db.VarChar(255)
  mfaEnabled         Boolean @default(false) @map("mfa_enabled") // task 0.7
  mfaSecretEncrypted String? @map("mfa_secret_encrypted") @db.VarChar(255) // task 0.7 — AES-256-GCM, lihat mfa.service.ts
  // (Placeholder isSysadmin task 0.7 sudah dipensiunkan task 0.8 — cek
  // sysadmin sekarang lewat UserRole->Role.roleCode="SUPER_ADMIN_PLATFORM",
  // lihat auth.service.ts.)

  // Beyond kolom literal PRD Modul 02 — dibutuhkan §7 (rate limiting/lockout)
  // task 0.6, PRD hanya mendefinisikan threshold-nya di password_policies.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz

  preferredLanguage Language @default(ID) @map("preferred_language")
  avatarUrl         String?  @map("avatar_url") @db.VarChar(500)

  hrisSyncSource   String?   @map("hris_sync_source") @db.VarChar(50)
  hrisLastSyncedAt DateTime? @map("hris_last_synced_at") @db.Timestamptz

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz

  createdBy     String?   @map("created_by") @db.Uuid
  createdByUser User?     @relation("UserCreatedByUser", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String?   @map("updated_by") @db.Uuid
  updatedByUser User?     @relation("UserUpdatedByUser", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  sessions  UserSession[]
  userRoles UserRole[]    @relation("UserRoleUser")

  // Task 0.9 — Workflow Engine
  workflowStagesAsApprover WorkflowStage[] @relation("WorkflowStageApproverUser")
  workflowTasksAssigned    WorkflowTask[]  @relation("WorkflowTaskAssignedUser")
  workflowTasksActedBy     WorkflowTask[]  @relation("WorkflowTaskActedByUser")
  workflowTasksDelegatedTo WorkflowTask[]  @relation("WorkflowTaskDelegatedToUser")

