  workPermitId String     @unique @map("work_permit_id") @db.Uuid
  workPermit   WorkPermit @relation(fields: [workPermitId], references: [id])

  workflowInstanceId String           @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id])

  currentStageName String? @map("current_stage_name") @db.VarChar(100)

  issuerApprovedBy     String?   @map("issuer_approved_by") @db.Uuid
  issuerApprovedByUser User?     @relation("WorkPermitApprovalIssuerApprover", fields: [issuerApprovedBy], references: [id])
