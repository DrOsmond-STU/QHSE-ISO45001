  title            String @db.VarChar(200)
  problemStatement String @map("problem_statement") @db.Text

  // siteId WAJIB (BEYOND nullability literal PRD §5 yang tidak eksplisit
  // menandai NULL) — numbering pattern CAPA/{SITE_CODE}/{YYYY}/{SEQ:4}
  // (§ Numbering) butuh site konkret utk resolve {SITE_CODE}, pola SAMA
  // audits.siteId (4.1) yang juga wajib demi alasan sama.
  companyId    String      @map("company_id") @db.Uuid
