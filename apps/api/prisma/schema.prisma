  initiatedBy     String   @map("initiated_by") @db.Uuid
  initiatedByUser User     @relation("CapaRegisterInitiatedBy", fields: [initiatedBy], references: [id])
  initiatedAt     DateTime @map("initiated_at") @db.Timestamptz

  targetClosureDate DateTime? @map("target_closure_date") @db.Date
  actualClosureDate DateTime? @map("actual_closure_date") @db.Date

  // Task 4.2 §8 "Root cause belum diisi mendekati SLA" — idempotency SATU
  // kolom (bukan tiered ala license 90/30/7, lihat memory) krn window-nya
  // SATU ambang flat (7 hari kalender sejak initiated_at, invented — PRD
  // tidak beri angka, gap TDD §26), pola sama audit-finding-closure-due-scan
  // "daily nag" TANPA idempotency kolom SEBENARNYA beda — di sini dipasang
  // krn window CAPA jauh lebih lebar (hari, bukan minggu) jadi re-notify
  // harian akan spam berlebihan.
