// ── Task 4.2 — CAPA Management (Modul 10) ───────────────────────────
// 13th domain module — HUB polymorphic (source_type/source_id) yang
// menerima trigger dari Incident (3.5)/Audit (4.1)/Inspection (3.6)/
// Compliance (2.2, kontrak belum final)/Risk (3.2, kontrak belum final)/
// Quality (Modul 11, BELUM ADA). MENUTUP 3 stub bare-UUID sebelumnya:
// incident_corrective_actions.capa_register_id (3.5, NOT NULL),
// audit_findings.capa_register_id (4.1, nullable),
// inspection_findings.escalated_capa_register_id (3.6, nullable) — SEMUA
// dikonversi jadi FK sungguhan DI BAWAH (lihat masing2 model), pola sama
// hiradc_records.work_permit_id retroactive FK (3.3). PRD §5 explanation
// eksplisit: source_id BUKAN FK literal DB (Postgres tidak dukung FK
// polymorphic native) — integritas direferensial BR-05 di service layer.
// KEDUA workflow process (entity_type=capa_action_plan/capa_effectiveness_verification)
// menunjuk ke BARIS ANAK (capa_action_plans.id/capa_effectiveness_verification.id),
// BUKAN capa_register.id — TAPI PRD §5 literal HANYA beri SATU kolom
// workflow_instance_id di capa_register itu sendiri (bukan di kedua tabel
// anak) — diinterpretasikan sbg "current/latest" convenience pointer
// (pola sama Audit audits.workflowInstanceId, 4.1), histori LENGKAP per
// stage ada di capa_approvals (1..N baris, MASING2 py workflow_instance_id
// wajib terisi sendiri). Stage "Root Cause Review" (PRD §4 "Opsional per
// tenant") TIDAK diimplementasikan sbg workflow_definitions sungguhan —
// TIDAK ADA kolom konfigurasi tenant utk itu di skema §5 literal, pola
// SAMA Inspection 3.6 (review opsional yang juga tidak diimplementasikan
// krn alasan identik).
enum CapaSourceType {
  INCIDENT
  AUDIT_FINDING
  INSPECTION_FINDING
  COMPLIANCE
  RISK
  CUSTOMER_COMPLAINT
  QUALITY_NCR
  MANAGEMENT_REVIEW
  OTHER
  // Task 5.2 — nilai BARU (bukan literal 9 asli task 4.2), lihat banner
  // comment blok Modul 12 di schema.prisma soal alasan enum ini perlu
  // diperluas alih-alih cuma divalidasi.
  ENVIRONMENTAL_ASPECT_IMPACT
  ENVIRONMENTAL_MONITORING
  // Task 5.3 (Modul 13 Occupational Health) — link caller-supplied
  // (linkCapaRegister(), BUKAN auto-trigger event), lihat banner comment
  // blok Modul 13 soal alasan BR-10 (deskripsi sistemik) tidak bisa
  // ditegakkan dari skema.
  OCCUPATIONAL_DISEASE_CASE
  // Task 6.2 (Modul 16 §4.2 poin 3, out_of_tolerance_records.linked_capa_id)
  // — link caller-supplied (OutOfToleranceRecordService.linkCapaRegister()),
  // pola PERSIS OCCUPATIONAL_DISEASE_CASE di atas. Ditambah SUSULAN saat
  // dokumentasi task 292 (bukan saat skema awal task 282) — ditemukan lewat
  // audit CapaRegisterService.assertSourceValidIfKnownContract() yang
  // banner comment-nya SENDIRI masih bilang "8 dari 12" tanpa kandidat
  // Modul 16, gap TDD §26 metodologi: kontrak CapaSourceType baru genuinely
  // kelihatan HANYA saat modul sumber sungguhan ditinjau ulang cross-module,
  // bukan otomatis dari menulis skema modul itu sendiri.
  CALIBRATION_OOT
}

