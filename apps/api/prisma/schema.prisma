  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("InspectionChecklistTemplateItemCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("InspectionChecklistTemplateItemUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  recordItems InspectionRecordItem[]

  @@index([tenantId, inspectionChecklistTemplateId, sequenceNo])
  @@map("inspection_checklist_template_items")
}

model InspectionSchedule {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("inspection_schedule_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  inspectionChecklistTemplateId String                      @map("inspection_checklist_template_id") @db.Uuid
  inspectionChecklistTemplate   InspectionChecklistTemplate @relation(fields: [inspectionChecklistTemplateId], references: [id])

  companyId    String?     @map("company_id") @db.Uuid
  company      Company?    @relation(fields: [companyId], references: [id])
  branchId     String?     @map("branch_id") @db.Uuid
  branch       Branch?     @relation(fields: [branchId], references: [id])
  siteId       String      @map("site_id") @db.Uuid
  site         Site        @relation(fields: [siteId], references: [id])
  departmentId String?     @map("department_id") @db.Uuid
