  sequenceNo Int      @default(0) @map("sequence_no")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  permissions Permission[]

  @@map("permission_groups")
}

model Permission {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @map("permission_id") @db.Uuid
  permissionCode    String   @unique @map("permission_code") @db.VarChar(150) // module_code.entity.action
  moduleCode        String   @map("module_code") @db.VarChar(50)
  entity            String   @db.VarChar(50)
  action            String   @db.VarChar(30)
  permissionGroupId String?  @map("permission_group_id") @db.Uuid
  description       String?  @db.VarChar(255)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  permissionGroup PermissionGroup? @relation(fields: [permissionGroupId], references: [id])
  rolePermissions RolePermission[]

  @@map("permissions")
}

// Global, platform-managed — TIDAK ADA tenant_id (Modul 02 §2.2), tidak
