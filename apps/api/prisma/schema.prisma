model EmergencyEquipmentReadinessChecklist {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("readiness_checklist_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id])

  // PRD §5 eksplisit "opsional numbering_configs" TANPA merinci kondisi
  // pemicu — BEDA dari inspection_records.inspection_record_number (3.6,
  // §13 Open Question, ambigu) yang di sana TETAP selalu digenerate.
  // Di sini SELALU dibiarkan NULL (numbering TIDAK diwiring) — interpretasi
  // "opsional" yang lebih literal & lebih rendah risiko krn PRD sendiri
  // tidak memberi kondisi kapan harus diisi.
  checklistNumber String? @map("checklist_number") @db.VarChar(50)

  // Modul 15 (Asset & Equipment, task 6.1) BELUM ADA — bare UUID TANPA FK,
  // TAPI kardinalitas NOT NULL dipertahankan sesuai literal PRD (BEDA dari
  // capa_id/linked_maintenance_record_id di bawah yang nullable) — lihat
  // banner comment awal blok modul ini.
  assetId String @map("asset_id") @db.Uuid

  inspectionDate DateTime @map("inspection_date") @db.Date

  checkedBy     String @map("checked_by") @db.Uuid
  checkedByUser User   @relation("EmergencyEquipmentReadinessChecklistCheckedBy", fields: [checkedBy], references: [id])

  readinessStatus  EquipmentReadinessStatus @map("readiness_status")
  issueDescription String?                  @map("issue_description") @db.Text

  // Modul 10 (CAPA)/Modul 15 (maintenance_records) BELUM ADA — bare UUID
