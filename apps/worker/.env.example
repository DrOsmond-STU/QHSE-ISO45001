# WorkflowSlaScanService (task 0.9) butuh koneksi admin-role langsung utk
# bootstrap query cross-tenant (SELECT DISTINCT tenant_id) — sama role yang
# dipakai Prisma CLI migrate, BUKAN role qhse_app.
DATABASE_URL="postgresql://postgres@localhost:5432/qhse_dev?schema=public"

# Dipakai PrismaService (via TenancyModule) utk query per-tenant RLS-scoped
# sesungguhnya — role qhse_app, TANPA privilege BYPASSRLS (TDD §5.2).
APP_DATABASE_URL="postgresql://qhse_app:qhse_dev_local@localhost:5432/qhse_dev?schema=public"

# Redis lokal portable (.local-redis/, lihat apps/api/scripts/dev-redis-setup.sh)
# — dipakai BullMQ Worker (koneksi sendiri, terpisah dari apps/api).
REDIS_URL="redis://127.0.0.1:6379"

# Override HANYA untuk uji manual (default produksi 15 menit, lihat
# workflow-engine.constants.ts) — supaya tidak perlu tunggu 15 menit
# sungguhan saat verifikasi end-to-end.
# WORKFLOW_SLA_SCAN_INTERVAL_MS=30000
