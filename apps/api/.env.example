# Dipakai Prisma CLI (migrate/generate) — role admin, pemilik tabel, hanya lokal dev.
DATABASE_URL="postgresql://postgres@localhost:5432/qhse_dev?schema=public"

# Dipakai runtime NestJS app — role qhse_app, TANPA privilege BYPASSRLS (TDD §5.2).
APP_DATABASE_URL="postgresql://qhse_app:qhse_dev_local@localhost:5432/qhse_dev?schema=public"

PORT=3001
