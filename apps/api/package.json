    "start": "node dist/main.js",
    "dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "lint": "echo \"(lint: eslint-config wiring TBD)\"",
    "db:setup": "bash scripts/dev-db-setup.sh",
    "db:migrate": "prisma migrate dev",
    "redis:setup": "bash scripts/dev-redis-setup.sh",
    "minio:setup": "bash scripts/dev-minio-setup.sh",
    "seed:auth-dev": "ts-node -r ts-node/register/transpile-only prisma/seed-auth-dev.ts",
