  createdByUser User      @relation("TenantSubscriptionCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("TenantSubscriptionUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, status])
  @@map("tenant_subscriptions")
}

// "1 tenant memiliki banyak module_entitlements (SATU per module_code)"
// (PRD §5 ERD ringkas) -> @@unique([tenantId, moduleCode]) langsung
// didukung teks PRD sendiri, bukan invensi.
model ModuleEntitlement {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @map("module_entitlement_id") @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  tenant           Tenant  @relation(fields: [tenantId], references: [id])
  moduleCode       String  @map("module_code") @db.VarChar(50)
  isEnabled        Boolean @default(true) @map("is_enabled")
  overrideReason   String? @map("override_reason")
  overriddenBy     String? @map("overridden_by") @db.Uuid
  overriddenByUser User?   @relation("ModuleEntitlementOverriddenBy", fields: [overriddenBy], references: [id])

  // BEYOND kolom literal PRD Modul 31 §5 (PRD tidak mencantumkan timestamp
  // apa pun utk tabel ini, memutus konvensi "audit standar" seluruh tabel
  // lain sejak Master PRD §11.3) — ditambahkan demi konsistensi (gap TDD
  // §26, pola sama notification_preferences/notification_logs 0.11 yang
  // JUGA menambah kolom beyond literal PRD demi konvensi wajib).
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, moduleCode])
  @@index([tenantId, isEnabled])
  @@map("module_entitlements")
}

// Snapshot berkala (job usage-counter-scan) — TIDAK ada created_by (system-
// generated, bukan aksi user, pola sama system_audit_logs).
model UsageCounter {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @map("usage_counter_id") @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  metricType   UsageMetricType @map("metric_type")
  currentValue Int             @map("current_value")
  measuredAt   DateTime        @default(now()) @map("measured_at") @db.Timestamptz

  @@index([tenantId, metricType, measuredAt])
  @@map("usage_counters")
}

// ── Task 1.6 — System Administration (import data & branding) ──────
// Modul 31 §5. File Excel ITU SENDIRI TIDAK disimpan lewat kolom baru di
// sini — direuse infrastruktur attachments (0.12) yang SUDAH menyediakan
// presign/confirm/malware-scan lengkap (TDD §11), lewat asosiasi
// polymorphic yang SUDAH ada (Attachment.entityType/entityId, bukan FK
// keras — pola sama WorkflowInstance). Relasinya: SATU baris `attachments`
// dengan entityType="DATA_IMPORT_JOB" & entityId=<data_import_job_id INI>.
// Id job DIGENERATE DI SERVICE LAYER (randomUUID(), bukan default DB) tepat
// SEBELUM attachment di-confirm() supaya bisa dipakai sbg entityId-nya,
// baru SETELAH itu baris data_import_jobs sendiri dibuat memakai id yang
// SAMA — menghindari deadlock ayam-telur (attachment butuh entityId
// entitas yang "sudah ada", job belum py file_url sebelum attachment
// confirm) tanpa menambah kolom FK attachment_id terpisah yang redundan.
enum DataImportJobStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model DataImportJob {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @map("data_import_job_id") @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  targetModuleCode String              @map("target_module_code") @db.VarChar(50)
  fileUrl          String              @map("file_url") @db.VarChar(500)
  status           DataImportJobStatus @default(UPLOADED)
  totalRows        Int?                @map("total_rows")
  successRows      Int?                @map("success_rows")
  errorRows        Int?                @map("error_rows")
  initiatedBy      String              @map("initiated_by") @db.Uuid
  initiatedByUser  User                @relation("DataImportJobInitiatedBy", fields: [initiatedBy], references: [id])

  // BEYOND kolom literal PRD Modul 31 §5 — Acceptance TASK_INSTRUCTION.md
  // 1.6 EKSPLISIT: "re-upload parsial baris gagal tertaut ke
  // data_import_job_id asal" — butuh FK diri-sendiri utk menyatakan
  // linkage itu, tidak ada kolom lain di skema literal yang bisa
  // memenuhinya. Pola sama WorkflowDelegation.sourceDelegationOfAuthorityId
  // (task 1.4).
  sourceDataImportJobId String?         @map("source_data_import_job_id") @db.Uuid
  sourceDataImportJob   DataImportJob?  @relation("DataImportJobRetry", fields: [sourceDataImportJobId], references: [id])
  retryJobs             DataImportJob[] @relation("DataImportJobRetry")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  errors DataImportError[]

  @@index([tenantId, status])
  @@index([sourceDataImportJobId])
  @@map("data_import_jobs")
}

// Kegagalan LEVEL-FILE (workbook corrupt/tidak bisa diparse, attachment
// INFECTED, dst — bukan kegagalan baris tertentu) direpresentasikan sbg
// SATU baris di sini dgn rowNumber=0 (bukan nomor Excel valid manapun,
// sentinel jelas), bukan kolom failure_reason terpisah di data_import_jobs
// — reuse tabel yang sudah ada drpd menambah kolom baru demi kasus yang
// jarang. rowNumber utk baris DATA biasa mengikuti nomor baris Excel APA
// ADANYA (row 1 = header, row 2 = baris data pertama) — BUKAN dihitung
// ulang mulai dari 1 utk baris data, supaya persis cocok dgn yang dilihat
// user saat membuka file yang sama di Excel (preview error per baris,
// PRD §12 Import Wizard step 3).
model DataImportError {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @map("data_import_error_id") @db.Uuid
  // BEYOND kolom literal PRD Modul 31 §5 (yang cuma sebut data_import_job_id
  // FK) — RLS WAJIB kolom tenant_id LANGSUNG di tabel ini sendiri (Master
  // PRD §11 poin 2, tidak bisa transitif lewat join ke data_import_jobs),
  // pola PERSIS WorkflowStage/WorkflowTransition (Master PRD §9 generic
  // schema) & HolidayCalendarEntry (Modul 01 §5) — SETIAP tabel anak di
  // codebase ini selalu dapat tenant_id sendiri, tanpa kecuali sejauh ini.
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  dataImportJobId String        @map("data_import_job_id") @db.Uuid
  dataImportJob   DataImportJob @relation(fields: [dataImportJobId], references: [id])
  rowNumber       Int           @map("row_number")
  errorMessage    String        @map("error_message")
  rawRowData      Json          @map("raw_row_data") @db.JsonB

  // BEYOND literal PRD (sama alasan gap module_entitlements di atas) —
  // TIDAK ada audit trigger di tabel ini (lihat migration RLS/trigger),
  // jadi created_at murni penanda kapan baris dicatat, bukan duplikasi.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@index([dataImportJobId, rowNumber])
  @@map("data_import_errors")
}

// tenants.primary_domain / tenants.logo_url (kolom SEJAK task 1.1, TIDAK
// PERNAH dipakai kode apa pun — diverifikasi grep kosong) tumpang tindih
// SEMANTIK dgn customDomain/logoUrl di bawah. TIDAK dibackfill/direuse di
// sini (2 sumber kebenaran berbeda dibiarkan, didokumentasikan TDD §26)
// krn tenants.* itu kolom bootstrap-time (diisi provisioning 1.5, kalau
// diisi), sedangkan tenant_branding_configs ini eksplisit py lifecycle
// CRUD sendiri lewat TenantBrandingService (Tenant Admin self-service,
// PRD §4.2/§12) — menyatukan keduanya sekarang berisiko migrasi data
// diam-diam tanpa keputusan produk eksplisit soal mana yang jadi sumber
// otoritatif.
model TenantBrandingConfig {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @map("tenant_branding_config_id") @db.Uuid
  tenantId     String  @unique @map("tenant_id") @db.Uuid
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  logoUrl      String? @map("logo_url") @db.VarChar(500)
  primaryColor String? @map("primary_color") @db.VarChar(20)
  displayName  String? @map("display_name") @db.VarChar(200)
  // UNIQUE lintas SELURUH platform (bukan per-tenant) — 2 tenant TIDAK
  // boleh klaim custom_domain yang sama, jadi ini WAJIB unique global,
  // beda dari kebanyakan @@unique lain di codebase ini yang selalu
  // composite dgn tenantId. NULL diperbolehkan ganda (semantik unique
  // index Postgres standar — belum ada custom_domain BUKAN "custom_domain
  // kosong" yang bentrok).
  customDomain String? @unique @map("custom_domain") @db.VarChar(200)

  // BEYOND kolom literal PRD Modul 31 §5 (sama alasan gap module_entitlements
  // — PRD tidak mencantumkan timestamp/audit apa pun utk tabel ini).
  createdBy     String   @map("created_by") @db.Uuid
  createdByUser User     @relation("TenantBrandingConfigCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String   @map("updated_by") @db.Uuid
  updatedByUser User     @relation("TenantBrandingConfigUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tenant_branding_configs")
}

// ============================================================================
// Task 2.1 — Document Management System (Modul 03). Depends on Workflow
// Engine (0.9 — approval document_versions, PRD §5 EKSPLISIT "TIDAK ada
// tabel document_approval terpisah", direalisasikan via workflow_instances
// entity_type='document_version'), Numbering (0.10 — document_number),
// Attachment (0.12 — REUSE presign/confirm/scan APA ADANYA utk file fisik,
// TAPI file_url/file_size/mime_type dicopy ke kolom document_versions milik
// sendiri, PRD §5 "Numbering & Attachments" EKSPLISIT bukan lewat tabel
// attachments generik — pola client-proposed-entityId sama persis 1.6),
// Notification (0.11 — PRD §8), User & Role (1.3 — Document Controller role
// baru + distribution target expansion).
// ============================================================================

enum DocumentType {
  POLICY
  MANUAL
  SOP
  WORK_INSTRUCTION
  FORM
  GUIDELINE
  RECORD
  EXTERNAL_STANDARD
  OTHER
}

enum DocumentClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  UNDER_REVISION
  OBSOLETE
  RETIRED
}

enum DocumentCategoryStatus {
  ACTIVE
  INACTIVE
}

enum DocumentVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  SUPERSEDED
  REJECTED
}

enum DistributionTargetType {
  USER
  ROLE
  DEPARTMENT
  SITE
  COMPANY
  ALL_TENANT
}

enum ReadAcknowledgementStatus {
  PENDING
  VIEWED
  ACKNOWLEDGED
  OVERDUE
}

enum AcknowledgementMethod {
  IN_APP_CLICK
  E_SIGNATURE
}

enum ReviewOutcome {
  NO_CHANGE_NEEDED
  MINOR_REVISION
  MAJOR_REVISION_TRIGGERED
  RETIRE_DOCUMENT
}

enum ReviewScheduleStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model DocumentCategory {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("document_category_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name String @db.VarChar(100)
  // BEYOND kolom literal PRD Modul 03 §5 (yang cuma sebut `name`) — dibutuhkan
  // NumberingService.generateNext() token {CATEGORY_CODE} (pattern disarankan
  // PRD §5 "Numbering & Attachments": "{PREFIX}/{CATEGORY_CODE}/{SITE_CODE}/
  // {YYYY}/{SEQ:3}") — tanpa ini tidak ada kolom apa pun yang bisa mengisi
  // token itu. Pola sama company_code/site_code/branch_code — kode pendek
  // per entity, unique PER TENANT (bukan global, 2 tenant boleh sama-sama
  // punya kategori "SOP").
  code String @db.VarChar(30)

  parentCategoryId String?            @map("parent_category_id") @db.Uuid
  parentCategory   DocumentCategory?  @relation("DocumentCategoryParent", fields: [parentCategoryId], references: [id])
  childCategories  DocumentCategory[] @relation("DocumentCategoryParent")

  defaultNumberingConfigId String?                @map("default_numbering_config_id") @db.Uuid
  defaultNumberingConfig   NumberingConfig?       @relation(fields: [defaultNumberingConfigId], references: [id])
  defaultReviewCycleMonths Int?                   @map("default_review_cycle_months")
  status                   DocumentCategoryStatus @default(ACTIVE)

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("DocumentCategoryCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("DocumentCategoryUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  documents Document[]

  @@unique([tenantId, code])
  @@map("document_categories")
}

model Document {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("document_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Scope keberlakuan — SEMUA nullable (PRD literal: "NULL pada level
  // tertentu berarti berlaku di atasnya, semua NULL = berlaku tenant-wide").
  // TIDAK ada FK berjenjang tervalidasi (mis. site harus di bawah company
  // yang sama) — konsisten pola scope longgar lain di codebase ini
  // (user_roles.scope_id), validasi konsistensi di luar timebox task ini.
  companyId    String?     @map("company_id") @db.Uuid
  company      Company?    @relation(fields: [companyId], references: [id])
  branchId     String?     @map("branch_id") @db.Uuid
  branch       Branch?     @relation(fields: [branchId], references: [id])
  siteId       String?     @map("site_id") @db.Uuid
  site         Site?       @relation(fields: [siteId], references: [id])
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation("DocumentScopeDepartment", fields: [departmentId], references: [id])

  documentNumber String       @map("document_number") @db.VarChar(100)
  title          String       @db.VarChar(255)
  documentType   DocumentType @map("document_type")

  documentCategoryId String           @map("document_category_id") @db.Uuid
  documentCategory   DocumentCategory @relation(fields: [documentCategoryId], references: [id])

  classification DocumentClassification @default(INTERNAL)
  description    String?                @db.Text

  ownerUserId String @map("owner_user_id") @db.Uuid
  ownerUser   User   @relation("DocumentOwnerUser", fields: [ownerUserId], references: [id])

  ownerDepartmentId String?     @map("owner_department_id") @db.Uuid
  ownerDepartment   Department? @relation("DocumentOwnerDepartment", fields: [ownerDepartmentId], references: [id])

  // Nullable — dokumen baru belum punya versi PUBLISHED (BR-02: hanya boleh
  // diarahkan ke document_versions berstatus PUBLISHED). NO hard FK di
  // schema Prisma (@relation biasa tanpa onDelete khusus) — di-update
  // DocumentWorkflowCompletionListener, BUKAN manual.
  currentVersionId String?          @unique @map("current_version_id") @db.Uuid
  currentVersion   DocumentVersion? @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id])

  status DocumentStatus @default(DRAFT)

  effectiveDate     DateTime? @map("effective_date") @db.Date
  reviewCycleMonths Int?      @map("review_cycle_months")
  // Denormalisasi dari document_review_schedule terbaru (PRD literal
  // "untuk kemudahan query dashboard") — diisi
  // DocumentReviewScheduleService, BUKAN sumber kebenaran (itu tetap
  // document_review_schedule.scheduled_review_date baris terbaru).
  nextReviewDate    DateTime? @map("next_review_date") @db.Date
  retentionYears    Int?      @map("retention_years")

  // Tag klausul ISO/regulasi terkait, mis. ["ISO45001:8.1.1"] — PRD literal
  // JSONB array, TIDAK divalidasi terhadap katalog regulasi formal (Modul 04
  // belum ada tabelnya, sama alasan gap event-category 1.7).
  relatedRegulatoryRefs Json @default("[]") @map("related_regulatory_refs") @db.JsonB

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("DocumentCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("DocumentUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  versions                            DocumentVersion[]                    @relation("DocumentVersionParent")
  distributions                       DocumentDistribution[]
  reviewSchedules                     DocumentReviewSchedule[]
  emergencyResponsePlans              EmergencyResponsePlan[]
  auditReports                        AuditReport[]
  qualityObjectives                   QualityObjective[]
  contractorPrequalificationDocuments ContractorPrequalificationDocument[]
  contractorDocumentCompliances       ContractorDocumentCompliance[]
  contractorProjectAssignments        ContractorProjectAssignment[]

  @@unique([tenantId, documentNumber])
  @@index([tenantId, documentCategoryId])
  @@index([tenantId, status])
  @@map("documents")
}

model DocumentVersion {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("document_version_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation("DocumentVersionParent", fields: [documentId], references: [id])

  majorVersion Int @default(1) @map("major_version")
  minorVersion Int @default(0) @map("minor_version")

  // PRD §5 EKSPLISIT: file fisik LANGSUNG di sini, bukan lewat attachments
  // generik. Internal implementation REUSE pipeline presign/confirm/scan
  // 0.12 apa adanya (client-proposed entityId = document_version_id ini,
  // pola PERSIS 1.6 gap #56) — kolom di bawah dicopy dari baris attachments
  // yang confirmed SETELAH scan CLEAN, lihat DocumentVersionService.
  fileName String @map("file_name") @db.VarChar(255)
  fileUrl  String @map("file_url") @db.VarChar(500)
  fileSize BigInt @map("file_size")
  mimeType String @map("mime_type") @db.VarChar(100)

  changeSummary String? @map("change_summary") @db.Text

  status DocumentVersionStatus @default(DRAFT)

  supersededByVersionId String?          @unique @map("superseded_by_version_id") @db.Uuid
  supersededByVersion   DocumentVersion? @relation("DocumentVersionSupersession", fields: [supersededByVersionId], references: [id])
  supersedesVersion     DocumentVersion? @relation("DocumentVersionSupersession")

  approvedAt  DateTime? @map("approved_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  // FK LANGSUNG ke workflow_instances (platform) — arah domain->platform,
  // BEDA dari workflow_instances.entity_id yang polymorphic tanpa FK (arah
  // sebaliknya platform->domain TIDAK BOLEH, lihat banner comment
  // WorkflowInstance). Nullable — versi DRAFT belum tentu sudah submit.
  workflowInstanceId String?           @unique @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("DocumentVersionCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("DocumentVersionUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  currentVersionOfDocument Document?                @relation("DocumentCurrentVersion")
  distributions            DocumentDistribution[]
  readAcknowledgementLogs  ReadAcknowledgementLog[]
  resultingOfReviews       DocumentReviewSchedule[] @relation("ReviewResultingVersion")

  @@unique([documentId, majorVersion, minorVersion])
  @@index([tenantId, documentId])
  @@map("document_versions")
}

model DocumentDistribution {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("document_distribution_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id])

  documentVersionId String          @map("document_version_id") @db.Uuid
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id])

  distributionTargetType DistributionTargetType @map("distribution_target_type")
  // Polymorphic sesuai target_type, NULL kalau ALL_TENANT — pola sama
  // workflow_instances.entity_id, TANPA FK (bisa menunjuk users/roles/
  // departments/sites/companies tergantung target_type).
  distributionTargetId   String?                @map("distribution_target_id") @db.Uuid

  requiresAcknowledgement Boolean @default(true) @map("requires_acknowledgement")
  acknowledgementDueDays  Int?    @map("acknowledgement_due_days")

  distributedAt     DateTime @default(now()) @map("distributed_at") @db.Timestamptz
  distributedBy     String   @map("distributed_by") @db.Uuid
  distributedByUser User     @relation("DocumentDistributionDistributedBy", fields: [distributedBy], references: [id])

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("DocumentDistributionCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("DocumentDistributionUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  readAcknowledgementLogs ReadAcknowledgementLog[]

  @@index([tenantId, documentId])
  @@index([tenantId, documentVersionId])
  @@map("document_distribution")
}

// TIDAK py created_by/updated_by/deleted_at (audit standar) — PRD literal
// cuma sebut created_at/updated_at, dan ini baris HASIL EKSPANSI OTOMATIS
// sistem per user target (high-frequency, system-generated), bukan aksi
// user langsung — pola SAMA persis data_import_errors (gap #54, 1.6) &
// usage_counters (1.5). TIDAK dapat audit_log_trigger (lihat migration)
// dengan alasan yang sama.
model ReadAcknowledgementLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("ack_log_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  documentDistributionId String               @map("document_distribution_id") @db.Uuid
  documentDistribution   DocumentDistribution @relation(fields: [documentDistributionId], references: [id])

  documentVersionId String          @map("document_version_id") @db.Uuid
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation("ReadAcknowledgementLogUser", fields: [userId], references: [id])

  status ReadAcknowledgementStatus @default(PENDING)

  viewedAt       DateTime? @map("viewed_at") @db.Timestamptz
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz

  acknowledgementMethod AcknowledgementMethod? @map("acknowledgement_method")
  // Referensi transaksi provider e-signature (Master PRD §13) — provider
  // BELUM diimplementasikan (Modul 30 belum ada, sama status "belum
  // dikonfigurasi" seluruh provider eksternal lain codebase ini: WA/
  // Telegram 0.11, malware scanner asli 0.12) — kolom schema-ready, method
  // E_SIGNATURE TIDAK BISA benar-benar dipilih end-to-end sampai providernya
  // ada, gap TDD §26.
  eSignatureRef         String?                @map("e_signature_ref") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([documentDistributionId, userId])
  @@index([tenantId, userId, status])
  @@map("read_acknowledgement_logs")
}

model DocumentReviewSchedule {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("review_schedule_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id])

  scheduledReviewDate DateTime  @map("scheduled_review_date") @db.Date
  actualReviewDate    DateTime? @map("actual_review_date") @db.Date

  reviewerUserId String? @map("reviewer_user_id") @db.Uuid
  reviewerUser   User?   @relation("DocumentReviewScheduleReviewer", fields: [reviewerUserId], references: [id])

  reviewOutcome ReviewOutcome? @map("review_outcome")

  resultingDocumentVersionId String?          @map("resulting_document_version_id") @db.Uuid
  resultingDocumentVersion   DocumentVersion? @relation("ReviewResultingVersion", fields: [resultingDocumentVersionId], references: [id])

  status ReviewScheduleStatus @default(SCHEDULED)

  // BEYOND kolom literal PRD Modul 03 §5 — idempotency natural-key job
  // document-review-scan (PRD §4.3 "H-30 sebelum scheduled_review_date,
  // notifikasi ke Document Owner"), pola PERSIS WorkflowTask.escalatedAt
  // (0.9): tanpa ini, reminder H-30 akan terkirim ULANG tiap kali job
  // harian jalan sepanjang jendela H-30..H-1 (bukan cuma tepat H-30, supaya
  // job yang absen tepat di hari H-30 tetap bisa "mengejar" di hari
  // berikutnya) — sekali terisi, PERMANEN dikecualikan dari pengiriman ulang.
  reviewReminderSentAt DateTime? @map("review_reminder_sent_at") @db.Timestamptz

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("DocumentReviewScheduleCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("DocumentReviewScheduleUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, documentId])
  @@index([tenantId, status, scheduledReviewDate])
  @@map("document_review_schedule")
}

// ============================================================================
// Task 2.2 — Regulatory & Compliance Management (Modul 04). Depends on
// Modul 01 (`industry_templates.default_regulatory_codes`, ADA SEJAK 1.2 —
// forward-built, konsumen PERTAMA kolom itu adalah task ini), Modul 02,
// Workflow Engine (0.9 — approval compliance_evaluations, 1-stage
// ROLE_IN_SCOPE, TIDAK butuh CONTEXT_USER seperti DMS 2.1 krn tidak ada
// "owner per entitas" di sini, evaluator ≠ approver secara struktural).
// linked_capa_id (compliance_evaluations) — UUID mentah TANPA FK ke Modul
// 10 (CAPA Management, BELUM ADA tabelnya sama sekali di codebase ini,
// Phase 2+ lain) — pola PERSIS workflow_instances.entity_id polymorphic.
// ============================================================================

enum RegulatoryFrameworkCategory {
  ISO_STANDARD
  GOVERNMENT_REGULATION
  INDUSTRY_GUIDELINE
}

enum RegulationType {
  LAW_UU
  GOVERNMENT_REGULATION_PP
  MINISTERIAL_REGULATION_PERMEN
  MINISTERIAL_DECREE_KEPMEN
  LOCAL_REGULATION_PERDA
  INTERNATIONAL_STANDARD
  COMPANY_INTERNAL_STANDARD
  GUIDELINE
}

enum ComplianceApplicableScope {
  ALL_TENANT
  SPECIFIC_COMPANY
  SPECIFIC_SITE
}

enum RegulatoryRegisterStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
}

enum ObligationType {
  REPORTING
  LICENSING
  TRAINING
  INSPECTION
  DOCUMENTATION
  ORGANIZATIONAL
  TECHNICAL_CONTROL
  OTHER
}

enum ObligationFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  AS_NEEDED
}

enum ObligationStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum EvaluationMethod {
  DOCUMENT_REVIEW
  SITE_VERIFICATION
  INTERVIEW
  COMBINED
}

enum ComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
  PARTIALLY_COMPLIANT
  NOT_APPLICABLE
}

enum ComplianceEvaluationStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  CLOSED
}

enum LicenseType {
  ENVIRONMENTAL_PERMIT
  OPERATIONAL_PERMIT
  SIO_OPERATOR_CERT
  BUILDING_PERMIT_PBG
  HAZWASTE_PERMIT_TPS_LB3
  PROPER_RATING
  OTHER
}

enum LicenseHolderType {
  COMPANY
  SITE
  EQUIPMENT
  INDIVIDUAL
}

enum LicenseStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  REVOKED
  IN_RENEWAL_PROCESS
}

// PRD §5 "Katalog payung GLOBAL (bukan tabel domain tenant)... dikelola
// Super Admin Platform" — pola PERSIS IndustryTemplate (1.2)/SubscriptionPlan
// (1.5): TIDAK ADA tenant_id sama sekali, dikecualikan otomatis dari generic
// RLS suite (0.3, introspeksi kolom tenant_id) tanpa whitelist manual.
model RegulatoryFramework {
  id          String                      @id @default(dbgenerated("gen_random_uuid()")) @map("framework_id") @db.Uuid
  code        String                      @unique @db.VarChar(30)
  name        String                      @db.VarChar(255)
  category    RegulatoryFrameworkCategory
  description String?                     @db.Text
  isActive    Boolean                     @default(true) @map("is_active")

  // TIDAK ada created_by/updated_by — sama alasan persis IndustryTemplate
  // (Master PRD §11 poin 3, "dikelola Super Admin Platform tanpa
  // created_by/updated_by per-tenant krn bersifat global").
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  registerEntries RegulatoryRegister[]

  @@map("regulatory_frameworks")
}

model RegulatoryRegister {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("regulatory_register_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  frameworkId String?              @map("framework_id") @db.Uuid
  framework   RegulatoryFramework? @relation(fields: [frameworkId], references: [id])

  regulationType   RegulationType @map("regulation_type")
  regulationNumber String         @map("regulation_number") @db.VarChar(100)
  title            String         @db.VarChar(500)
  issuingAuthority String?        @map("issuing_authority") @db.VarChar(150)
  issueDate        DateTime?      @map("issue_date") @db.Date
  effectiveDate    DateTime?      @map("effective_date") @db.Date

  applicableScope     ComplianceApplicableScope @default(ALL_TENANT) @map("applicable_scope")
  applicableCompanyId String?                   @map("applicable_company_id") @db.Uuid
  applicableCompany   Company?                  @relation(fields: [applicableCompanyId], references: [id])
  applicableSiteId    String?                   @map("applicable_site_id") @db.Uuid
  applicableSite      Site?                     @relation(fields: [applicableSiteId], references: [id])

  // JSONB array, mis. ["MANUFACTURING","OIL_GAS"] — PRD literal "awalnya
  // diseed dari industry_templates", TIDAK divalidasi terhadap katalog
  // formal (IndustryTemplate.code SUDAH ada sbg katalog formal 1.2, tapi
  // PRD Modul 04 §5 sendiri tidak minta FK/enum ke situ, cukup JSONB bebas).
  industryRelevance Json    @default("[]") @map("industry_relevance") @db.JsonB
  summary           String? @db.Text
  sourceUrl         String? @map("source_url") @db.VarChar(500)

  status                 RegulatoryRegisterStatus @default(ACTIVE)
  supersededByRegisterId String?                  @unique @map("superseded_by_register_id") @db.Uuid
  supersededByRegister   RegulatoryRegister?      @relation("RegulatoryRegisterSupersession", fields: [supersededByRegisterId], references: [id])
  supersedesRegister     RegulatoryRegister?      @relation("RegulatoryRegisterSupersession")

  reviewCycleMonths Int?      @map("review_cycle_months")
  nextReviewDate    DateTime? @map("next_review_date") @db.Date

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("RegulatoryRegisterCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("RegulatoryRegisterUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  obligations ComplianceObligation[]
  evaluations ComplianceEvaluation[]
  licenses    LicensePermit[]

  @@index([tenantId, status])
  @@index([tenantId, frameworkId])
  @@map("regulatory_register")
}

model ComplianceObligation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("obligation_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  regulatoryRegisterId String             @map("regulatory_register_id") @db.Uuid
  regulatoryRegister   RegulatoryRegister @relation(fields: [regulatoryRegisterId], references: [id])

  obligationCode        String?        @map("obligation_code") @db.VarChar(50)
  clauseReference       String?        @map("clause_reference") @db.VarChar(100)
  obligationDescription String         @map("obligation_description") @db.Text
  obligationType        ObligationType @map("obligation_type")

  responsibleUserId       String?     @map("responsible_user_id") @db.Uuid
  responsibleUser         User?       @relation("ComplianceObligationResponsibleUser", fields: [responsibleUserId], references: [id])
  responsibleDepartmentId String?     @map("responsible_department_id") @db.Uuid
  responsibleDepartment   Department? @relation(fields: [responsibleDepartmentId], references: [id])
  applicableSiteId        String?     @map("applicable_site_id") @db.Uuid
  applicableSite          Site?       @relation(fields: [applicableSiteId], references: [id])

  frequency   ObligationFrequency @map("frequency")
  nextDueDate DateTime?           @map("next_due_date") @db.Date
  status      ObligationStatus    @default(ACTIVE)

  // BEYOND skema literal PRD §5 — PRD §8 minta 2 notifikasi terpisah
  // berbasis next_due_date ("Evaluasi kepatuhan jatuh tempo"/H-30 before,
  // "Obligation overdue"/lewat tempo) yang keduanya butuh idempotency
  // TERSENDIRI (pola sama expiryReminder{90,30,7}SentAt di LicensePermit)
  // supaya job harian tidak mengirim ulang tiap hari selama next_due_date
  // belum berubah. Di-RESET ke NULL setiap kali next_due_date dihitung
  // ulang (BR-06, ComplianceEvaluationService.close()) — perpindahan
  // next_due_date ke masa depan itulah yang "menyelesaikan" due/overdue
  // sebelumnya, jadi reset di titik itu SATU-SATUNYA tempat yang perlu.
  dueReminderSentAt DateTime? @map("due_reminder_sent_at") @db.Timestamptz
  overdueNotifiedAt DateTime? @map("overdue_notified_at") @db.Timestamptz

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("ComplianceObligationCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("ComplianceObligationUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  evaluations ComplianceEvaluation[]

  @@index([tenantId, regulatoryRegisterId])
  @@index([tenantId, status, nextDueDate])
  @@map("compliance_obligations")
}

model ComplianceEvaluation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("evaluation_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  evaluationNumber String @map("evaluation_number") @db.VarChar(100)

  regulatoryRegisterId String?               @map("regulatory_register_id") @db.Uuid
  regulatoryRegister   RegulatoryRegister?   @relation(fields: [regulatoryRegisterId], references: [id])
  obligationId         String?               @map("obligation_id") @db.Uuid
  obligation           ComplianceObligation? @relation(fields: [obligationId], references: [id])
  siteId               String?               @map("site_id") @db.Uuid
  site                 Site?                 @relation(fields: [siteId], references: [id])

  evaluationPeriodStart DateTime @map("evaluation_period_start") @db.Date
  evaluationPeriodEnd   DateTime @map("evaluation_period_end") @db.Date

  evaluatorUserId String @map("evaluator_user_id") @db.Uuid
  evaluatorUser   User   @relation("ComplianceEvaluationEvaluator", fields: [evaluatorUserId], references: [id])

  evaluationDate   DateTime         @map("evaluation_date") @db.Date
  evaluationMethod EvaluationMethod @map("evaluation_method")
  complianceStatus ComplianceStatus @map("compliance_status")
  findingsSummary  String?          @map("findings_summary") @db.Text

  capaTriggered Boolean @default(false) @map("capa_triggered")
  // UUID mentah TANPA FK — Modul 10 (CAPA Management) BELUM ADA tabelnya di
  // codebase ini (Phase 2+ lain), pola PERSIS workflow_instances.entity_id.
  linkedCapaId  String? @map("linked_capa_id") @db.Uuid

  nextEvaluationDueDate DateTime?                  @map("next_evaluation_due_date") @db.Date
  status                ComplianceEvaluationStatus @default(DRAFT)

  workflowInstanceId String?           @unique @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("ComplianceEvaluationCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("ComplianceEvaluationUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([tenantId, evaluationNumber])
  @@index([tenantId, status])
  @@index([tenantId, obligationId])
  @@map("compliance_evaluations")
}

model LicensePermit {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("license_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])
  siteId    String?  @map("site_id") @db.Uuid
  site      Site?    @relation(fields: [siteId], references: [id])

  licenseNumber    String      @map("license_number") @db.VarChar(100)
  licenseName      String      @map("license_name") @db.VarChar(255)
  licenseType      LicenseType @map("license_type")
  issuingAuthority String?     @map("issuing_authority") @db.VarChar(150)

  regulatoryRegisterId String?             @map("regulatory_register_id") @db.Uuid
  regulatoryRegister   RegulatoryRegister? @relation(fields: [regulatoryRegisterId], references: [id])

  holderType        LicenseHolderType @map("holder_type")
  // Polymorphic sesuai holder_type: company_id/site_id/asset_id (Modul 15,
  // BELUM ADA)/user_id (Modul 02, ADA) — TANPA FK (bisa menunjuk tabel yang
  // belum ada), pola PERSIS document_distribution.distribution_target_id.
  holderReferenceId String?           @map("holder_reference_id") @db.Uuid

  issueDate           DateTime      @map("issue_date") @db.Date
  expiryDate          DateTime?     @map("expiry_date") @db.Date
  renewalLeadTimeDays Int           @default(90) @map("renewal_lead_time_days")
  status              LicenseStatus @default(ACTIVE)

  // BEYOND skema literal PRD §5 — job harian (BR-01) mengirim notifikasi
  // BERTINGKAT H-90/H-30/H-7 (3 checkpoint TETAP, independen dari
  // renewal_lead_time_days per-license yang cuma menggerakkan status
  // EXPIRING_SOON). Tanpa kolom idempotency terpisah per-tier, job yang
  // jalan harian akan mengirim ulang notifikasi tier yang SAMA setiap hari
  // selama expiry_date masih dalam window itu — pola SAMA dgn
  // review_reminder_sent_at (2.1) tapi butuh 3 kolom krn 3 checkpoint
  // independen (bukan 1 checkpoint spt review schedule).
  expiryReminder90SentAt DateTime? @map("expiry_reminder_90_sent_at") @db.Timestamptz
  expiryReminder30SentAt DateTime? @map("expiry_reminder_30_sent_at") @db.Timestamptz
  expiryReminder7SentAt  DateTime? @map("expiry_reminder_7_sent_at") @db.Timestamptz

  renewalOfLicenseId String?        @unique @map("renewal_of_license_id") @db.Uuid
  renewalOfLicense   LicensePermit? @relation("LicensePermitRenewal", fields: [renewalOfLicenseId], references: [id])
  renewedByLicense   LicensePermit? @relation("LicensePermitRenewal")

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("LicensePermitCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("LicensePermitUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  // Task 5.2 — 1:1 ekstensi Modul 12 Environmental Management (BR-05).
  environmentalPermit EnvironmentalPermit?

  @@index([tenantId, status])
  @@index([tenantId, expiryDate])
  @@index([tenantId, holderType, holderReferenceId])
  @@map("licenses_permits")
}

// ═══════════════════════════════════════════════════════════════════════
// Task 3.1 (Modul 05 §5) — Risk Management: matriks risiko konfigurabel +
// hazard register. Cakupan task ini SENGAJA dibatasi ke 4 tabel ini saja
// (risk_matrix_configs/levels/cells + hazard_register) — hira_assessments/
// jsa_records/hiradc_records/risk_register/risk_treatment_plans (PRD §5
// sisanya) adalah cakupan task 3.2 terpisah (TASK_INSTRUCTION.md), BELUM
// dibangun di sini.
// ═══════════════════════════════════════════════════════════════════════

enum RiskMatrixModuleScope {
  HIRA
  JSA
  HIRADC
  CORPORATE_RISK
  ALL
}

enum RiskMatrixAxis {
  LIKELIHOOD
  SEVERITY
}

enum HazardCategory {
  PHYSICAL
  CHEMICAL
  BIOLOGICAL
  ERGONOMIC
  PSYCHOSOCIAL
  MECHANICAL
  ELECTRICAL
  ENVIRONMENTAL
  OTHER
}

enum HazardRegisterStatus {
  ACTIVE
  INACTIVE
}

// PRD §5 "wajib versioned agar perubahan matriks tidak mengubah skor
// historis assessment yang sudah disetujui" (BR-09) — RiskMatrixConfigService.createNewVersion()
// membuat BARIS BARU version+1, baris LAMA tidak disentuh sama sekali
// selain isActive->false (bukan UPDATE kolom lain apa pun) — assessment
// (task 3.2+) yang sudah menyimpan risk_matrix_config_id lama tetap
// menunjuk baris lama itu apa adanya, skornya tidak pernah berubah
// retroaktif. TIDAK ADA kolom self-referencing "supersedes"/
// "previous_version_id" (PRD §5 literal tidak memintanya, beda dari
// RegulatoryRegister.supersededByRegisterId 2.2 yang eksplisit diminta) —
// rangkaian versi cukup diidentifikasi via (tenantId, applicableModuleScope,
// version), baris isActive=true TERBARU per scope itulah yang kanonik.
model RiskMatrixConfig {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("risk_matrix_config_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name                  String                @db.VarChar(150)
  applicableModuleScope RiskMatrixModuleScope @default(ALL) @map("applicable_module_scope")
  likelihoodLevels      Int                   @default(5) @map("likelihood_levels")
  severityLevels        Int                   @default(5) @map("severity_levels")
  version               Int                   @default(1)
  isActive              Boolean               @default(true) @map("is_active")

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("RiskMatrixConfigCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("RiskMatrixConfigUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  levels RiskMatrixLevel[]
  cells  RiskMatrixCell[]

  // Task 3.2 — konsumen SUNGGUHAN pertama risk_matrix_config_id di luar
  // task 3.1 sendiri.
  hiraAssessments HiraAssessment[]
  riskRegisters   RiskRegister[]

  // BR-09/PRD §5 literal "Hanya 1 versi aktif per (tenant_id,
  // applicable_module_scope)" — partial unique index (WHERE is_active),
  // TIDAK bisa diekspresikan `@@unique` DSL biasa (Postgres tidak men-dedup
  // FALSE di unique index reguler) — ditulis manual di migration.sql, pola
  // PERSIS numbering_configs (0.10)/notification_templates (0.11). Index
  // reguler di bawah ini cuma bantu performa query, BUKAN constraint.
  @@index([tenantId, applicableModuleScope, isActive])
  @@map("risk_matrix_configs")
}

// Child table — label tiap level likelihood/severity. Audit MINIMAL
// (createdAt/updatedAt saja, TANPA created_by/updated_by/deleted_at) sesuai
// tabel literal PRD §5 (beda dari risk_matrix_configs/hazard_register yang
// py audit standar penuh) — baris ini ditulis SEKALIGUS dgn parent-nya saat
// authoring matriks (Visual Builder, PRD §12), tidak pernah diedit satu-satu.
model RiskMatrixLevel {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("risk_matrix_level_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  riskMatrixConfigId String           @map("risk_matrix_config_id") @db.Uuid
  riskMatrixConfig   RiskMatrixConfig @relation(fields: [riskMatrixConfigId], references: [id])

  axis        RiskMatrixAxis
  levelValue  Int            @map("level_value")
  label       String         @db.VarChar(100)
  description String?        @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // BEYOND kolom literal — natural-key uniqueness (satu config tidak boleh
  // py dua baris "LIKELIHOOD level 3"), gap TDD §26 kalau ternyata perlu
  // sengaja diizinkan duplikat utk kasus yang belum ditemukan.
  @@unique([riskMatrixConfigId, axis, levelValue])
  @@index([tenantId, riskMatrixConfigId])
  @@map("risk_matrix_levels")
}

// Child table — skor & level tiap kombinasi likelihood x severity. Audit
// minimal, alasan sama RiskMatrixLevel di atas.
model RiskMatrixCell {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("risk_matrix_cell_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  riskMatrixConfigId String           @map("risk_matrix_config_id") @db.Uuid
  riskMatrixConfig   RiskMatrixConfig @relation(fields: [riskMatrixConfigId], references: [id])

  likelihoodValue           Int     @map("likelihood_value")
  severityValue             Int     @map("severity_value")
  riskScore                 Int     @map("risk_score")
  // VARCHAR bebas (BUKAN Prisma enum) — PRD §5 literal eksplisit "label
  // dapat dikustomisasi tenant", beda dari SELURUH field status lain di
  // codebase ini yang selalu enum tetap; BR-01 (task 3.2) baca nilai ini
  // apa adanya sbg string, tidak pernah membandingkan terhadap daftar tetap.
  riskLevel                 String  @map("risk_level") @db.VarChar(30)
  colorCode                 String  @map("color_code") @db.VarChar(10)
  requiredActionDescription String? @map("required_action_description") @db.Text

  // BEYOND kolom literal (task 3.2) — resolusi TDD §26 gap #89: PRD §4.1
  // poin 3 (percabangan kondisional HIRA) & BR-06 (gate ACCEPT+EXTREME)
  // KEDUANYA menguji risk_level thd string literal "EXTREME", TAPI
  // riskLevel di ATAS sengaja free-text tenant-customizable (comment di
  // atas) — membandingkan string akan SALAH begitu tenant mengganti label.
  // requiresEscalation flag TERSTRUKTUR (bukan string) jadi satu-satunya
  // sumber kebenaran utk "cell ini butuh eskalasi", riskLevel MURNI tampilan
  // (UI/laporan). Default generator (default-risk-matrix.ts) set TRUE utk
  // band EXTREME (score>=16); tenant custom matrix (Visual Builder) BEBAS
  // set true/false per cell independen dari label yang dipakai.
  requiresEscalation Boolean @default(false) @map("requires_escalation")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([riskMatrixConfigId, likelihoodValue, severityValue])
  @@index([tenantId, riskMatrixConfigId])
  @@map("risk_matrix_cells")
}

// Daftar bahaya master reusable lintas HIRA/JSA/HIRADC (task 3.2 akan
// mereferensikan hazard_id dari hira_hazard_lines/jsa_step_hazards/
// hiradc_lines — TABEL-TABEL ITU BELUM ADA di task ini). BR-07 (tidak
// dapat dihapus permanen selama masih direferensikan) — TIDAK ADA method
// hard-delete di service manapun di seluruh codebase ini sejak awal
// (konvensi soft-delete universal via deletedAt), jadi BR-07 terpenuhi
// by construction; validasi referensial ke tabel anak (yang belum ada)
// menyusul task 3.2 (gap TDD §26).
model HazardRegister {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("hazard_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  siteId String? @map("site_id") @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id])

  hazardCode           String?              @map("hazard_code") @db.VarChar(30)
  hazardCategory       HazardCategory       @map("hazard_category")
  hazardDescription    String               @map("hazard_description") @db.Text
  potentialConsequence String?              @map("potential_consequence") @db.Text
  status               HazardRegisterStatus @default(ACTIVE)

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("HazardRegisterCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("HazardRegisterUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  // Task 3.2 — dipakai retire() (HazardRegisterService) utk BR-07 validasi
  // referensial (gap TDD §26 #92, ditutup task 3.2).
  hiraHazardLines HiraHazardLine[]
  jsaStepHazards  JsaStepHazard[]
  hiradcLines     HiradcLine[]

  @@index([tenantId, status])
  @@index([tenantId, siteId])
  @@map("hazard_register")
}

// ═══════════════════════════════════════════════════════════════════════
// Task 3.2 (Modul 05 §5, sisa) — HIRA/JSA/HIRADC alur transaksional +
// risk_register korporat. Melanjutkan task 3.1 (risk_matrix_configs/cells/
// hazard_register, DI ATAS) — resolveRiskScore()/RiskMatrixConfigService/
// HazardRegisterService dikonsumsi PERTAMA KALI oleh model-model di bawah.
// ═══════════════════════════════════════════════════════════════════════

enum HiraAssessmentType {
  ROUTINE
  NON_ROUTINE
  PROJECT_BASED
  PERIODIC_REVIEW
}

enum HiraAssessmentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  REQUIRES_REVISION
  ARCHIVED
}

enum ControlHierarchy {
  ELIMINATION
  SUBSTITUTION
  ENGINEERING
  ADMINISTRATIVE
  PPE
}

enum JsaRecordStatus {
  DRAFT
  APPROVED
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum HiradcRecordStatus {
  DRAFT
  VERIFIED
  APPROVED
  EXPIRED
}

enum RiskCategory {
  STRATEGIC
  OPERATIONAL
  FINANCIAL
  COMPLIANCE
  REPUTATIONAL
  HSE
  IT_SECURITY
  OTHER
}

enum RiskAppetiteStatus {
  WITHIN_APPETITE
  EXCEEDS_APPETITE
}

enum CorporateRiskStatus {
  IDENTIFIED
  ASSESSED
  TREATMENT_IN_PROGRESS
  MONITORED
  CLOSED
}

enum RiskTreatmentSourceType {
  RISK_REGISTER
  HIRA_LINE
  HIRADC_LINE
}

enum RiskTreatmentStrategy {
  AVOID
  REDUCE_MITIGATE
  TRANSFER
  ACCEPT
}

enum RiskTreatmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  VERIFIED_EFFECTIVE
  CANCELLED
}

// Header penilaian risiko tingkat proses/aktivitas (PRD §4.1/§5).
model HiraAssessment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("hira_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  hiraNumber String @map("hira_number") @db.VarChar(100)

  siteId       String      @map("site_id") @db.Uuid
  site         Site        @relation(fields: [siteId], references: [id])
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  activityDescription String             @map("activity_description") @db.Text
  assessmentType      HiraAssessmentType @map("assessment_type")

  riskMatrixConfigId String           @map("risk_matrix_config_id") @db.Uuid
  riskMatrixConfig   RiskMatrixConfig @relation(fields: [riskMatrixConfigId], references: [id])

  assessmentDate DateTime             @map("assessment_date") @db.Date
  reviewDueDate  DateTime?            @map("review_due_date") @db.Date
  status         HiraAssessmentStatus @default(DRAFT)

  // BEYOND kolom literal (task 3.2) — PRD §8 baris 2 "Mendekati
  // review_due_date HIRA -> Pemilik HIRA", idempotency utk hira-review-due-scan
  // (job BARU, pola PERSIS document_review_schedule.reviewReminderSentAt
  // 2.1) — ditemukan mid-implementasi saat menyusun HiraAssessmentService,
  // TIDAK ada di rencana skema 11-tabel awal task ini.
  reviewReminderSentAt DateTime? @map("review_reminder_sent_at") @db.Timestamptz

  workflowInstanceId String?           @unique @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("HiraAssessmentCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("HiraAssessmentUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  teamMembers   HiraTeamMember[]
  hazardLines   HiraHazardLine[]
  jsaRecords    JsaRecord[]
  hiradcRecords HiradcRecord[]

  // Task 5.3 — Occupational Health (populasi berisiko diturunkan dari HIRA)
  healthSurveillancePrograms HealthSurveillanceProgram[]
  occupationalDiseaseCases   OccupationalDiseaseCase[]

  @@unique([tenantId, hiraNumber])
  @@index([tenantId, status])
  @@index([tenantId, siteId])
  @@map("hira_assessments")
}

model HiraTeamMember {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("hira_team_member_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  hiraId String         @map("hira_id") @db.Uuid
  hira   HiraAssessment @relation(fields: [hiraId], references: [id])
  userId String         @map("user_id") @db.Uuid
  user   User           @relation("HiraTeamMemberUser", fields: [userId], references: [id])

  roleInTeam String? @map("role_in_team") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([hiraId, userId])
  @@index([tenantId, hiraId])
  @@map("hira_team_members")
}

// Detail baris penilaian per bahaya (before/after control) — PRD §5.
model HiraHazardLine {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("hira_line_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  hiraId String         @map("hira_id") @db.Uuid
  hira   HiraAssessment @relation(fields: [hiraId], references: [id])

  hazardId                  String?         @map("hazard_id") @db.Uuid
  hazard                    HazardRegister? @relation(fields: [hazardId], references: [id])
  hazardDescriptionFreetext String?         @map("hazard_description_freetext") @db.Text
  existingControls          String?         @map("existing_controls") @db.Text

  likelihoodBefore Int    @map("likelihood_before")
  severityBefore   Int    @map("severity_before")
  riskScoreBefore  Int    @map("risk_score_before")
  riskLevelBefore  String @map("risk_level_before") @db.VarChar(30)

  // BR-02 (PRD §6) — wajib diisi kalau riskLevelAfter masih HIGH/EXTREME
  // sebelum baris ini boleh dianggap APPROVED (ditegakkan
  // assertAdditionalControlsIfStillHighRisk(), hira-hazard-line-rules.ts).
  additionalControlsRequired String?           @map("additional_controls_required") @db.Text
  controlHierarchy           ControlHierarchy? @map("control_hierarchy")

  likelihoodAfter    Int     @map("likelihood_after")
  severityAfter      Int     @map("severity_after")
  riskScoreAfter     Int     @map("risk_score_after")
  riskLevelAfter     String  @map("risk_level_after") @db.VarChar(30)
  // BEYOND kolom literal (task 3.2) — denormalisasi dari risk_matrix_cells
  // utk pasangan (likelihoodAfter,severityAfter), pola PERSIS
  // risk_matrix_cells.requiresEscalation (lihat banner comment di sana).
  // Dipakai BR-06 (RiskTreatmentPlanService) saat source_type=HIRA_LINE
  // mengacu baris ini — risiko yang "diterima" (ACCEPT) adalah risiko
  // RESIDUAL/setelah kontrol, bukan risiko mentah/before (yang dipakai
  // TERPISAH utk keputusan percabangan workflow HIRA sendiri, dihitung
  // transient saat submit, TIDAK disimpan sbg kolom krn hanya perlu SEKALI).
  requiresEscalation Boolean @default(false) @map("requires_escalation")

  responsibleUserId    String?   @map("responsible_user_id") @db.Uuid
  responsibleUser      User?     @relation("HiraHazardLineResponsibleUser", fields: [responsibleUserId], references: [id])
  targetCompletionDate DateTime? @map("target_completion_date") @db.Date

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("HiraHazardLineCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("HiraHazardLineUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, hiraId])
  @@index([tenantId, hazardId])
  @@map("hira_hazard_lines")
}

// Header Job Safety Analysis (PRD §4.2/§5).
model JsaRecord {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("jsa_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  jsaNumber String @map("jsa_number") @db.VarChar(100)

  siteId       String      @map("site_id") @db.Uuid
  site         Site        @relation(fields: [siteId], references: [id])
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  jobTitle       String  @map("job_title") @db.VarChar(255)
  jobDescription String? @map("job_description") @db.Text

  preparedBy     String  @map("prepared_by") @db.Uuid
  preparedByUser User    @relation("JsaRecordPreparedBy", fields: [preparedBy], references: [id])
  reviewedBy     String? @map("reviewed_by") @db.Uuid
  reviewedByUser User?   @relation("JsaRecordReviewedBy", fields: [reviewedBy], references: [id])

  assessmentDate DateTime  @map("assessment_date") @db.Date
  validUntil     DateTime? @map("valid_until") @db.Date

  linkedHiraId String?         @map("linked_hira_id") @db.Uuid
  linkedHira   HiraAssessment? @relation(fields: [linkedHiraId], references: [id])

  status JsaRecordStatus @default(DRAFT)

  workflowInstanceId String?           @unique @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("JsaRecordCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("JsaRecordUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  jobSteps             JsaJobStep[]
  crewAcknowledgements JsaCrewAcknowledgement[]
  hiradcRecords        HiradcRecord[]
  workPermits          WorkPermit[]

  @@unique([tenantId, jsaNumber])
  @@index([tenantId, status])
  @@index([tenantId, siteId])
  @@map("jsa_records")
}

model JsaJobStep {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("jsa_step_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  jsaId String    @map("jsa_id") @db.Uuid
  jsa   JsaRecord @relation(fields: [jsaId], references: [id])

  sequenceNo      Int    @map("sequence_no")
  stepDescription String @map("step_description") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  stepHazards JsaStepHazard[]

  @@unique([jsaId, sequenceNo])
  @@index([tenantId, jsaId])
  @@map("jsa_job_steps")
}

model JsaStepHazard {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("jsa_step_hazard_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  jsaStepId String     @map("jsa_step_id") @db.Uuid
  jsaStep   JsaJobStep @relation(fields: [jsaStepId], references: [id])

  hazardId                  String?         @map("hazard_id") @db.Uuid
  hazard                    HazardRegister? @relation(fields: [hazardId], references: [id])
  hazardDescriptionFreetext String?         @map("hazard_description_freetext") @db.Text
  potentialRisk             String?         @map("potential_risk") @db.Text
  controlMeasures           String          @map("control_measures") @db.Text
  ppeRequired               Json            @default("[]") @map("ppe_required") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId, jsaStepId])
  @@index([tenantId, hazardId])
  @@map("jsa_step_hazards")
}

// Sign-off kru sebelum mulai bekerja (ISO 45001 §5.4) — PRD §4.2 poin 3.
model JsaCrewAcknowledgement {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("ack_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  jsaId  String    @map("jsa_id") @db.Uuid
  jsa    JsaRecord @relation(fields: [jsaId], references: [id])
  userId String    @map("user_id") @db.Uuid
  user   User      @relation("JsaCrewAcknowledgementUser", fields: [userId], references: [id])

  workDate       DateTime @map("work_date") @db.Date
  acknowledgedAt DateTime @map("acknowledged_at") @db.Timestamptz
  signatureRef   String?  @map("signature_ref") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // PRD §5 literal "1 per user per work_date" — unique constraint
  // menegakkan BR implisit ini (BUKAN cuma prosa, DB-level).
  @@unique([jsaId, userId, workDate])
  @@index([tenantId, jsaId])
  @@map("jsa_crew_acknowledgements")
}

// Catatan verifikasi titik-kerja (point-of-work) — PRD §4.3/§5.
model HiradcRecord {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("hiradc_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  hiradcNumber String @map("hiradc_number") @db.VarChar(100)

  siteId       String      @map("site_id") @db.Uuid
  site         Site        @relation(fields: [siteId], references: [id])
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  relatedHiraId String?         @map("related_hira_id") @db.Uuid
  relatedHira   HiraAssessment? @relation(fields: [relatedHiraId], references: [id])
  relatedJsaId  String?         @map("related_jsa_id") @db.Uuid
  relatedJsa    JsaRecord?      @relation(fields: [relatedJsaId], references: [id])
  // FK SUNGGUHAN ditambahkan task 3.3 begitu work_permits genuinely ada —
  // pola PERSIS tenants.industryTemplateId (FK ditambahkan 1.1->1.2, TDD
  // §26 #21). Migration terpisah ALTER TABLE ADD CONSTRAINT (task 3.3),
  // BUKAN bagian migration init 11-tabel task 3.2 aslinya.
  workPermitId  String?         @map("work_permit_id") @db.Uuid
  workPermit    WorkPermit?     @relation(fields: [workPermitId], references: [id])

  taskDescription String @map("task_description") @db.Text
  performedBy     String @map("performed_by") @db.Uuid
  performedByUser User   @relation("HiradcRecordPerformedBy", fields: [performedBy], references: [id])

  assessmentDatetime DateTime           @map("assessment_datetime") @db.Timestamptz
  status             HiradcRecordStatus @default(DRAFT)
  validUntil         DateTime?          @map("valid_until") @db.Timestamptz

  workflowInstanceId String?           @unique @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("HiradcRecordCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("HiradcRecordUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  lines HiradcLine[]

  @@unique([tenantId, hiradcNumber])
  @@index([tenantId, status])
  @@index([tenantId, siteId])
  @@index([tenantId, validUntil])
  @@map("hiradc_records")
}

// Detail baris bahaya-risiko-kontrol per HIRADC — PRD §5 "audit standar
// (ringkas, tanpa update mengingat sifat sekali-pakai)": createdBy/createdAt
// SAJA, TIDAK ADA updatedBy/updatedAt/deletedAt (literal, BEDA dari SELURUH
// tabel lain di codebase ini yang selalu audit standar penuh).
model HiradcLine {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("hiradc_line_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  hiradcId String       @map("hiradc_id") @db.Uuid
  hiradc   HiradcRecord @relation(fields: [hiradcId], references: [id])

  hazardId                  String?         @map("hazard_id") @db.Uuid
  hazard                    HazardRegister? @relation(fields: [hazardId], references: [id])
  hazardDescriptionFreetext String?         @map("hazard_description_freetext") @db.Text

  likelihood         Int     @map("likelihood")
  severity           Int     @map("severity")
  riskScore          Int     @map("risk_score")
  riskLevel          String  @map("risk_level") @db.VarChar(30)
  // BEYOND kolom literal — pola PERSIS hira_hazard_lines.requiresEscalation,
  // dipakai BR-06 saat risk_treatment_plans.source_type=HIRADC_LINE.
  requiresEscalation Boolean @default(false) @map("requires_escalation")

  controlMeasures String @map("control_measures") @db.Text
  ppeRequired     Json   @default("[]") @map("ppe_required") @db.JsonB

  createdBy     String   @map("created_by") @db.Uuid
  createdByUser User     @relation("HiradcLineCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, hiradcId])
  @@index([tenantId, hazardId])
  @@map("hiradc_lines")
}

// Risiko korporat (strategis/operasional/finansial/dst) — PRD §4.4/§5,
// BUKAN risiko operasional lapangan harian (itu HIRA/JSA/HIRADC di atas).
model RiskRegister {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("risk_register_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  riskNumber String @map("risk_number") @db.VarChar(100)

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  riskCategory    RiskCategory @map("risk_category")
  riskTitle       String       @map("risk_title") @db.VarChar(255)
  riskDescription String       @map("risk_description") @db.Text

  riskOwnerUserId String @map("risk_owner_user_id") @db.Uuid
  riskOwnerUser   User   @relation("RiskRegisterOwner", fields: [riskOwnerUserId], references: [id])

  riskMatrixConfigId String           @map("risk_matrix_config_id") @db.Uuid
  riskMatrixConfig   RiskMatrixConfig @relation(fields: [riskMatrixConfigId], references: [id])

  likelihoodInherent Int    @map("likelihood_inherent")
  severityInherent   Int    @map("severity_inherent")
  riskScoreInherent  Int    @map("risk_score_inherent")
  riskLevelInherent  String @map("risk_level_inherent") @db.VarChar(30)

  currentControls String? @map("current_controls") @db.Text

  likelihoodResidual Int     @map("likelihood_residual")
  severityResidual   Int     @map("severity_residual")
  riskScoreResidual  Int     @map("risk_score_residual")
  riskLevelResidual  String  @map("risk_level_residual") @db.VarChar(30)
  // BEYOND kolom literal — dari risk_matrix_cells utk pasangan
  // (likelihoodResidual,severityResidual), pola PERSIS
  // hira_hazard_lines.requiresEscalation. Residual (BUKAN inherent) yang
  // dipakai krn BR-06 soal "risiko yang DITERIMA" (ACCEPT) — apa yang
  // tersisa SETELAH kontrol berjalan, bukan risiko mentah sebelum kontrol.
  requiresEscalation Boolean @default(false) @map("requires_escalation")

  riskAppetiteStatus RiskAppetiteStatus? @map("risk_appetite_status")

  identifiedDate DateTime            @map("identified_date") @db.Date
  lastReviewDate DateTime?           @map("last_review_date") @db.Date
  nextReviewDate DateTime?           @map("next_review_date") @db.Date
  status         CorporateRiskStatus @default(IDENTIFIED)

  // BEYOND kolom literal (task 3.2) — idempotency BR-05 ("next_review_date
  // terlewati ... ditandai overdue pada dashboard"), pola PERSIS
  // compliance_obligations.overdueNotifiedAt (2.2) — direset NULL begitu
  // lastReviewDate diperbarui (menyelesaikan siklus overdue).
  overdueNotifiedAt DateTime? @map("overdue_notified_at") @db.Timestamptz

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("RiskRegisterCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("RiskRegisterUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([tenantId, riskNumber])
  @@index([tenantId, status])
  @@index([tenantId, nextReviewDate])
  @@map("risk_register")
}

// Rencana penanganan risiko — polymorphic source (RISK_REGISTER/HIRA_LINE/
// HIRADC_LINE), PRD §4.4/§5.
model RiskTreatmentPlan {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("risk_treatment_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  sourceType RiskTreatmentSourceType @map("source_type")
  // Polymorphic sesuai source_type — TANPA FK (bisa menunjuk 3 tabel
  // berbeda), pola PERSIS document_distribution.distribution_target_id.
  sourceId   String                  @map("source_id") @db.Uuid

  treatmentStrategy    RiskTreatmentStrategy @map("treatment_strategy")
  treatmentDescription String                @map("treatment_description") @db.Text

  responsibleUserId String   @map("responsible_user_id") @db.Uuid
  responsibleUser   User     @relation("RiskTreatmentPlanResponsibleUser", fields: [responsibleUserId], references: [id])
  targetDate        DateTime @map("target_date") @db.Date

  // Referensi lintas-modul opsional — Modul 24 (Action Tracking)/Modul 10
  // (CAPA) BELUM ADA tabelnya di codebase ini, bare UUID tanpa FK.
  actionTrackingId String? @map("action_tracking_id") @db.Uuid
  capaId           String? @map("capa_id") @db.Uuid

  status                   RiskTreatmentStatus @default(PLANNED)
  effectivenessReviewNotes String?             @map("effectiveness_review_notes") @db.Text

  // BEYOND kolom literal (task 3.2) — PRD §8 baris 4 "risk_treatment_plans
  // overdue -> Responsible user, atasan" — idempotency utk scan job, pola
  // PERSIS risk_register.overdueNotifiedAt (di atas)/compliance_obligations.overdueNotifiedAt
  // (2.2). Direset NULL begitu status berubah keluar dari
  // PLANNED/IN_PROGRESS (selesai/dibatalkan menyelesaikan siklus overdue).
  overdueNotifiedAt DateTime? @map("overdue_notified_at") @db.Timestamptz

  // BEYOND kolom literal (task 3.2) — BR-06 ("treatment_strategy=ACCEPT
  // pada risiko EXTREME wajib approval eksplisit Top Management, tidak
  // dapat 'accept' sendiri oleh risk owner biasa"). PRD §5 literal
  // risk_treatment_plans TIDAK py kolom/workflow_instance_id APAPUN utk
  // approval — guardrail ini disederhanakan jadi PASANGAN kolom (BUKAN
  // Workflow Engine 1-stage penuh, dianggap di luar timebox utk satu
  // guardrail sempit) yang WAJIB terisi sebelum assertAcceptRequiresTopManagementApproval()
  // (risk-treatment-rules.ts) meloloskan status ACCEPT+EXTREME — SIAPA
  // yang boleh mengisi field ini adalah tanggung jawab RBAC/controller
  // masa depan (permission risk.corporate_risk.approve), service ini HANYA
  // menegakkan "field terisi", bukan "pengisinya genuinely Top Management".
  topManagementApprovedBy     String?   @map("top_management_approved_by") @db.Uuid
  topManagementApprovedByUser User?     @relation("RiskTreatmentPlanTopManagementApprover", fields: [topManagementApprovedBy], references: [id])
  topManagementApprovedAt     DateTime? @map("top_management_approved_at") @db.Timestamptz

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("RiskTreatmentPlanCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("RiskTreatmentPlanUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, status])
  @@map("risk_treatment_plans")
}

// ============================================================================
// Task 3.3 — Modul 06 Work Permit Management (tipe & alur inti). Cakupan
// SENGAJA DIBATASI (TASK_INSTRUCTION.md 3.3 vs 3.4): work_permit_extensions/
// work_permit_closures DITUNDA ke task 3.4 terpisah — WorkPermitStatus di
// bawah tetap mencantumkan SELURUH 13 nilai literal PRD §5 (enum Postgres
// adalah infrastruktur bersama, menambah value lewat migration terpisah
// nanti lebih berisiko drpd mencantumkannya sekarang), TAPI
// validateWorkPermitStatusTransition() (pure fn, task 3.3) HANYA menegakkan
// transisi yang genuinely bisa dicapai tanpa tabel extension/closure —
// ACTIVE sengaja jadi dead-end di validator versi task 3.3, 3.4 yang
// memperluasnya begitu tabel itu ada.
// ============================================================================

enum WorkPermitRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum WorkPermitStatus {
  DRAFT
  SUBMITTED
  PENDING_ISSUER_APPROVAL
  PENDING_HSE_APPROVAL
  APPROVED
  ACTIVE
  SUSPENDED
  EXTENSION_REQUESTED
  PENDING_CLOSURE
  CLOSED
  REJECTED
  CANCELLED
  EXPIRED
}

enum GasType {
  OXYGEN
  LEL_FLAMMABLE
  H2S
  CO
  VOC
  OTHER
}

enum GasTestResultValue {
  PASS
  FAIL
}

enum IsolationType {
  ELECTRICAL
  MECHANICAL
  PROCESS_PIPING
  PNEUMATIC
  HYDRAULIC
  OTHER
}

enum IsolationLotoStatus {
  APPLIED
  VERIFIED
  REMOVED
}

enum WorkPermitApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

// PRD §2.1 "Konfigurasi tipe izin kerja per tenant (Hot Work, ..., DAN TIPE
// CUSTOM LAIN)" — `code` SENGAJA VARCHAR bebas (BUKAN Prisma enum tertutup),
// pola PERSIS risk_matrix_cells.risk_level (task 3.1, gap TDD §26 #89):
// daftar literal PRD (HOT_WORK/COLD_WORK/dst) adalah SET AWAL yang di-seed,
// bukan satu-satunya nilai yang boleh ada — enum Prisma tertutup akan
// bertentangan langsung dengan "tipe custom lain".
model WorkPermitType {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("work_permit_type_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code        String  @db.VarChar(30)
  name        String  @db.VarChar(150)
  description String? @db.Text

  requiresGasTest        Boolean             @default(false) @map("requires_gas_test")
  requiresLoto           Boolean             @default(false) @map("requires_loto")
  requiresHseApproval    Boolean             @default(false) @map("requires_hse_approval")
  defaultRiskLevel       WorkPermitRiskLevel @default(LOW) @map("default_risk_level")
  defaultValidityHours   Int                 @default(8) @map("default_validity_hours")
  maxExtensionCount      Int                 @default(1) @map("max_extension_count")
  gasRetestIntervalHours Int?                @map("gas_retest_interval_hours")
  isActive               Boolean             @default(true) @map("is_active")

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("WorkPermitTypeCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("WorkPermitTypeUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  workPermits WorkPermit[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("work_permit_types")
}

model WorkPermit {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("work_permit_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  permitNumber String @map("permit_number") @db.VarChar(50)

  workPermitTypeId String         @map("work_permit_type_id") @db.Uuid
  workPermitType   WorkPermitType @relation(fields: [workPermitTypeId], references: [id])

  // company_id/branch_id BEYOND site_id wajib (PRD §5 literal mencantumkan
  // ketiganya, HANYA site_id ditandai NOT NULL) — didenormalisasi dgn
  // alasan PERSIS departments.companyId/branchId (task 1.1): kemudahan
  // filter scope RBAC (PRD §3 modul ini: HSE Manager "scope company/branch
  // dalam scope-nya") tanpa join ke sites tiap panggil.
  companyId    String?     @map("company_id") @db.Uuid
  company      Company?    @relation(fields: [companyId], references: [id])
  branchId     String?     @map("branch_id") @db.Uuid
  branch       Branch?     @relation(fields: [branchId], references: [id])
  siteId       String      @map("site_id") @db.Uuid
  site         Site        @relation(fields: [siteId], references: [id])
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  title          String  @db.VarChar(200)
  description    String  @db.Text
  locationDetail String? @map("location_detail") @db.VarChar(200)

  requesterId String @map("requester_id") @db.Uuid
  requester   User   @relation("WorkPermitRequester", fields: [requesterId], references: [id])

  // Task 6.3 — FK sungguhan ke contractors (Modul 17), sebelumnya bare UUID
  // TANPA FK sejak 3.3 (pola waktu itu PERSIS risk_treatment_plans.action_tracking_id
  // 3.2). BR-02 Modul 17 (blokir permit requester_type=CONTRACTOR saat dokumen
  // wajib EXPIRED) ditegakkan di WorkPermitService, lihat banner comment
  // blok Modul 17 schema.prisma.
  contractorCompanyId String?     @map("contractor_company_id") @db.Uuid
  contractorCompany   Contractor? @relation(fields: [contractorCompanyId], references: [id])

  relatedJsaId String?    @map("related_jsa_id") @db.Uuid
  relatedJsa   JsaRecord? @relation(fields: [relatedJsaId], references: [id])

  riskLevel WorkPermitRiskLevel @map("risk_level")

  plannedStartDatetime DateTime  @map("planned_start_datetime") @db.Timestamptz
  plannedEndDatetime   DateTime  @map("planned_end_datetime") @db.Timestamptz
  actualStartDatetime  DateTime? @map("actual_start_datetime") @db.Timestamptz
  actualEndDatetime    DateTime? @map("actual_end_datetime") @db.Timestamptz

  numberOfWorkers Int? @map("number_of_workers")

  status WorkPermitStatus @default(DRAFT)

  workflowInstanceId String?           @unique @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  customFields Json @default("{}") @map("custom_fields") @db.JsonB

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("WorkPermitCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("WorkPermitUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  hazardChecklist      WorkPermitHazardChecklist?
  gasTestResults       GasTestResult[]
  isolationLotoRecords IsolationLotoRecord[]
  approvalCache        WorkPermitApproval?
  hiradcRecords        HiradcRecord[]
  extensions           WorkPermitExtension[]
  closure              WorkPermitClosure?
  incidentReports      IncidentReport[]

  @@unique([tenantId, permitNumber])
  @@index([tenantId, status])
  @@index([tenantId, siteId])
  @@map("work_permits")
}

// PRD §5 — jawaban checklist bahaya dinamis, form builder berbasis
// custom_fields (Master PRD §11.7). Definisi item checklist per tipe
// idealnya lewat custom_field_definitions (Modul 31) — TABEL ITU BELUM ADA
// di codebase ini (gap TDD §26), jadi custom_fields di sini murni JSONB
// bebas TANPA validasi skema terhadap definisi manapun; caller
// bertanggung jawab penuh atas bentuk datanya.
model WorkPermitHazardChecklist {
