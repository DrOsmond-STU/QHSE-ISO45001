{
  "name": "@qhse/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "lint": "echo \"(lint: eslint-config wiring TBD)\"",
    "db:setup": "bash scripts/dev-db-setup.sh",
    "db:migrate": "prisma migrate dev",
    "test": "jest",
    "test:integration": "jest --testPathPatterns=integration-spec"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.9.0",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "prisma": "5.22.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
