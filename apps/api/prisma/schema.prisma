  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("WorkPermitApprovalUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@map("work_permit_approvals")
}

// ============================================================================
// Task 3.4 — Modul 06 Work Permit Management (extension, closure & cross-link).
// Melanjutkan task 3.3 (tipe & alur inti) — cakupan sisa yang SENGAJA ditunda:
// work_permit_extensions/work_permit_closures, BR-05/06/07, E2E-1.
// ============================================================================

enum WorkPermitExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkPermitClosureStatus {
  SUBMITTED
  VERIFIED
  CLOSED
  RETURNED
}

// PRD §5 — "disetujui ulang oleh Issuer (dan HSE jika tipe mengharuskan
// retest gas)." workflow_instance_id (entity_type=work_permit_extension,
// PRD literal) — KETIGA kalinya JSON Logic condition dipakai pada
// workflow_transitions di seluruh codebase (setelah HIRA 3.2, Work Permit
// Stage 2 HSE 3.3) — condition kali ini `gasRetestRequired` (field
// PADA work_permit_extensions itu sendiri, BUKAN turunan risk_level/
// requires_hse_approval spt permit induknya).
model WorkPermitExtension {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("work_permit_extension_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  workPermitId String     @map("work_permit_id") @db.Uuid
  workPermit   WorkPermit @relation(fields: [workPermitId], references: [id])

  requestedNewEndDatetime DateTime @map("requested_new_end_datetime") @db.Timestamptz
  reason                  String   @db.Text
  gasRetestRequired       Boolean  @map("gas_retest_required")

  workflowInstanceId String?           @unique @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  status WorkPermitExtensionStatus @default(PENDING)

  requestedBy     String   @map("requested_by") @db.Uuid
  requestedByUser User     @relation("WorkPermitExtensionRequestedBy", fields: [requestedBy], references: [id])
  requestedAt     DateTime @map("requested_at") @db.Timestamptz

  decidedBy     String?   @map("decided_by") @db.Uuid
  decidedByUser User?     @relation("WorkPermitExtensionDecidedBy", fields: [decidedBy], references: [id])
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("WorkPermitExtensionCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("WorkPermitExtensionUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, workPermitId])
  @@map("work_permit_extensions")
}

// PRD §5 — "1 record penutupan final per permit (percobaan return dicatat
// via status)" — workPermitId UNIQUE, SATU baris seumur hidup permit;
// RETURNED (Issuer menolak verifikasi) TIDAK membuat baris baru, Requester
// merevisi+submit ULANG baris YANG SAMA (status RETURNED->SUBMITTED lagi).
// TIDAK ADA workflow_instance_id (BEDA dari extensions) — verifikasi
// closure adalah tindakan LANGSUNG satu orang (Issuer/Area Authority),
// BUKAN alur Workflow Engine multi-stage, pola sama HIRADC self-verify (3.2).
model WorkPermitClosure {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("work_permit_closure_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  workPermitId String     @unique @map("work_permit_id") @db.Uuid
  workPermit   WorkPermit @relation(fields: [workPermitId], references: [id])

  areaSafetyChecklist       Json    @default("{}") @map("area_safety_checklist") @db.JsonB
  isolationRemovedConfirmed Boolean @default(false) @map("isolation_removed_confirmed")

  requesterSignoffBy     String   @map("requester_signoff_by") @db.Uuid
  requesterSignoffByUser User     @relation("WorkPermitClosureRequesterSignoff", fields: [requesterSignoffBy], references: [id])
  requesterSignoffAt     DateTime @map("requester_signoff_at") @db.Timestamptz

  verifiedBy     String?   @map("verified_by") @db.Uuid
  verifiedByUser User?     @relation("WorkPermitClosureVerifiedBy", fields: [verifiedBy], references: [id])
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz

  status WorkPermitClosureStatus @default(SUBMITTED)
  notes  String?                 @db.Text

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("WorkPermitClosureCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("WorkPermitClosureUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@map("work_permit_closures")
}

// ============================================================================
// Task 3.5 — Incident Management (Modul 07). 9th domain module — hanya
// mereferensikan work_permits (Modul 06) via FK Prisma langsung (bare,
// TIDAK ada NestJS import). PRD §5 literal py `workflow_instance_id` di
// KEDUA `incident_reports` DAN `incident_investigations` — dibaca sbg
// duplikasi draft (dokumen ini masih "Draft 0.1, menunggu review
// stakeholder"), keduanya jelas menunjuk SATU workflow yang sama (§4 poin 7
// eksplisit "entity_type=incident_investigation") — HANYA diimplementasikan
// di `incident_investigations` (pola SATU FK per entity_type, konsisten
// seluruh modul lain), gap didokumentasikan TDD §26.
// ============================================================================

