}

model EmergencyResponsePlan {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("emergency_response_plan_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  branchId  String? @map("branch_id") @db.Uuid
  branch    Branch? @relation(fields: [branchId], references: [id])
  siteId    String  @map("site_id") @db.Uuid
  site      Site    @relation(fields: [siteId], references: [id])

  planNumber String @map("plan_number") @db.VarChar(50)
  planTitle  String @map("plan_title") @db.VarChar(200)

  emergencyType       EmergencyType @map("emergency_type")
  scenarioDescription String        @map("scenario_description") @db.Text

  defaultMusterPointId String?               @map("default_muster_point_id") @db.Uuid
  defaultMusterPoint   EmergencyMusterPoint? @relation(fields: [defaultMusterPointId], references: [id])

  // FK SUNGGUHAN — Modul 03 DMS SUDAH ADA (task 2.1), beda dari
  // capa_id/asset_id/certification_reference_id di tabel lain modul ini.
  relatedDocumentId String?   @map("related_document_id") @db.Uuid
  relatedDocument   Document? @relation(fields: [relatedDocumentId], references: [id])

  severityLevel   EmergencyPlanSeverityLevel   @map("severity_level")
  reviewFrequency EmergencyPlanReviewFrequency @default(ANNUAL) @map("review_frequency")

  lastReviewedDate  DateTime? @map("last_reviewed_date") @db.Date
  nextReviewDueDate DateTime? @map("next_review_due_date") @db.Date
  reviewedBy        String?   @map("reviewed_by") @db.Uuid
  reviewedByUser    User?     @relation("EmergencyResponsePlanReviewedBy", fields: [reviewedBy], references: [id])
  approvedBy        String?   @map("approved_by") @db.Uuid
  approvedByUser    User?     @relation("EmergencyResponsePlanApprovedBy", fields: [approvedBy], references: [id])
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz

  effectiveDate DateTime? @map("effective_date") @db.Date
  version       Int       @default(1)

  // BR-09 §4.1 — module_code=EMERGENCY_PLAN, 2-stage kondisional (KELIMA
  // JSON Logic condition di codebase ini, setelah HIRA 3.2/Work Permit HSE
  // 3.3/Work Permit Extension 3.4/Incident investigasi 3.5) — lihat
  // EmergencyResponseWorkflowBootstrapService.
  workflowInstanceId String?           @unique @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  status EmergencyPlanStatus @default(DRAFT)

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("EmergencyResponsePlanCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("EmergencyResponsePlanUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  planSteps   EmergencyResponsePlanStep[]
  drills      EmergencyDrill[]
  activations EmergencyActivation[]

  @@unique([tenantId, planNumber])
  @@index([tenantId, siteId, status])
  @@index([tenantId, status, nextReviewDueDate])
  @@map("emergency_response_plans")
}

