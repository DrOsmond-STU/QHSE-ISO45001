  @@index([tenantId, inspectionRecordId])
  @@map("inspection_scores")
}

// ── Task 3.7 — Emergency Response (Modul 14) ────────────────────────
// Modul DOMAIN KESEBELAS. Dependency PRD: Modul 15 (Asset & Equipment,
