// ───────────────────────────────────────────────────────────────────────
// Task 1.2 — template industri & kalender hari libur (PRD Modul 01 §5)
// ───────────────────────────────────────────────────────────────────────

// Tabel global/lookup PLATFORM (TDD §6.3 "Data referensi non-tenant") — TIDAK
// ADA kolom tenant_id sama sekali (bukan nullable seperti roles/
// role_permissions 0.8 — kolomnya memang tidak ada di PRD Modul 01 §5),
// dikelola Super Admin Platform (org.industry_template.manage) sebagai
// starting point setup wizard tenant baru (PRD §4.1 — disalin, bukan
// direferensi langsung, supaya bisa dikustomisasi per tenant). Karena tanpa
// tenant_id, tabel ini OTOMATIS terkecualikan dari generic RLS suite
// (introspeksi information_schema.columns WHERE column_name='tenant_id',
// task 0.3) — tidak butuh whitelist manual maupun kebijakan RLS asimetris.
model IndustryTemplate {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @map("industry_template_id") @db.Uuid
  code        String  @unique @db.VarChar(30)
  name        String  @db.VarChar(150)
  description String?

  defaultRegulatoryCodes    Json @default("[]") @map("default_regulatory_codes")
  defaultChecklistRefs      Json @default("[]") @map("default_checklist_refs")
  defaultModuleEntitlements Json @default("[]") @map("default_module_entitlements")

  isSystemDefined Boolean @default(true) @map("is_system_defined")
  isActive        Boolean @default(true) @map("is_active")

  // TIDAK ada created_by/updated_by (beda dari SELURUH tabel domain lain,
  // Master PRD §11 poin 3) — PRD Modul 01 §5 eksplisit: "Dikelola Super
  // Admin Platform, tanpa created_by/updated_by per-tenant karena bersifat
  // global." Audit trail perubahan tetap tercatat via audit_log_trigger
  // (tenant_id NULL di system_audit_logs, actor_user_id tetap terisi dari
  // current_setting('app.current_user_id') — tabel PERTAMA tanpa tenant_id
  // yang melekatkan trigger ini, lihat migration attach trigger & TDD §26).
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenants   Tenant[]
  companies Company[]

  @@map("industry_templates")
}

model HolidayCalendar {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("holiday_calendar_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name String @db.VarChar(150)

  // NULL = kalender tenant-wide (kandidat default, lihat isDefault di
  // bawah); terisi = kalender khusus SATU site (PRD Modul 01 §5) — beda dari
  // Site.holidayCalendarId (site ini MEMAKAI kalender yang mana), relasi
  // FK terpisah walau sama-sama HolidayCalendar<->Site.
  appliesToSiteId String? @map("applies_to_site_id") @db.Uuid
  appliesToSite   Site?   @relation("HolidayCalendarAppliesToSite", fields: [appliesToSiteId], references: [id])

  country String @default("ID") @db.VarChar(2)

  // BR-05 (PRD Modul 01 §6) — hanya SATU kalender per tenant boleh
  // is_default=true; ditegakkan HolidayCalendarService (transactional
  // unset-then-set), SENGAJA bukan DB unique index semata (soft-delete
  // filter, konfirmasi PRD eksplisit di deskripsi kolom §5).
  isDefault Boolean @default(false) @map("is_default")

  status OrgEntityStatus @default(ACTIVE)

  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy String    @map("updated_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  entries            HolidayCalendarEntry[]
  sitesUsingCalendar Site[]                 @relation("SiteHolidayCalendarUsage")

  @@index([tenantId, status])
  @@map("holiday_calendars")
