#!/bin/bash
# ============================================================================
#  Contoh ~/qhse-secrets.sh — SALIN, isi nilai aslinya, lalu `chmod 600`.
#
#  Berkas asli TIDAK BOLEH masuk repositori. Ia dipisahkan justru supaya
#  qhse-runner.sh bisa dicadangkan ke repositori publik tanpa membawa
#  kredensial ikut serta.
#
#  Aplikasi membaca seluruh konfigurasinya dari process.env langsung — tidak
#  ada dotenv/ConfigModule di jalur produksi — jadi `export` di sini memang
#  satu-satunya sumbernya.
# ============================================================================

# Basis data PostgreSQL cPanel. DATABASE_URL dipakai Prisma untuk migrasi
# (koneksi pemilik tabel), APP_DATABASE_URL dipakai aplikasi saat melayani
# permintaan. Di shared hosting keduanya user yang sama karena cPanel tidak
# mengizinkan CREATE ROLE.
DB_URL='postgresql://USER:SANDI@127.0.0.1:5432/NAMA_DB?schema=public'
export DATABASE_URL="$DB_URL"
export APP_DATABASE_URL="$DB_URL"

# Penanda tangan access token. Ganti = seluruh sesi aktif langsung tidak sah.
export JWT_ACCESS_TOKEN_SECRET='ganti-dengan-nilai-acak-panjang'

# Kunci enkripsi rahasia MFA pengguna.
export MFA_SECRET_ENCRYPTION_KEY='ganti-dengan-base64-32-byte'

# Kunci induk enkripsi data kesehatan (Modul 13). KEHILANGAN KUNCI INI
# BERARTI KEHILANGAN SELURUH REKAM MEDIS — ia tidak bisa dipulihkan dari
# cadangan basis data saja. Simpan salinannya terpisah dari server.
export PHI_ENCRYPTION_MASTER_KEY='ganti-dengan-base64-32-byte'

# Melindungi POST /internal/cron/run-scans supaya hanya cron yang boleh
# memicu 31 scheduled job.
export CRON_SECRET='ganti-dengan-nilai-acak'

# Menandatangani URL unduhan lampiran saat STORAGE_MODE=local.
export LOCAL_STORAGE_SIGNING_SECRET='ganti-dengan-nilai-acak'
