model CalibrationSchedule {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("calibration_schedule_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  calibrationItemId String          @map("calibration_item_id") @db.Uuid
