// Agregat terhitung berkala (BR-06, job scheduler) — TIDAK ADA unique
// constraint DB-level pada kombinasi scope+period (company_id/branch_id/
// site_id SEMUA nullable independen, Postgres tidak men-dedup NULL di
// composite unique — pola gotcha yang sama numbering_configs/
// notification_templates, tapi 3 dimensi nullable independen butuh sampai
// 8 partial index kalau ditegakkan DB-level, berlebihan utk tabel CACHE
// murni) — idempotency ditegakkan SERVICE layer (query-then-upsert dalam
// satu transaksi), bukan constraint DB.
model IncidentStatisticsCache {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("incident_statistics_cache_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])
  branchId  String?  @map("branch_id") @db.Uuid
  branch    Branch?  @relation(fields: [branchId], references: [id])
  siteId    String?  @map("site_id") @db.Uuid
  site      Site?    @relation(fields: [siteId], references: [id])

  periodType      IncidentStatisticsPeriodType @map("period_type")
  periodStartDate DateTime                     @map("period_start_date") @db.Date
  periodEndDate   DateTime                     @map("period_end_date") @db.Date

  totalManhoursWorked Decimal @map("total_manhours_worked") @db.Decimal(18, 2)

  fatalityCount           Int @default(0) @map("fatality_count")
  ltiCount                Int @default(0) @map("lti_count")
  restrictedWorkCount     Int @default(0) @map("restricted_work_count")
  medicalTreatmentCount   Int @default(0) @map("medical_treatment_count")
  firstAidCount           Int @default(0) @map("first_aid_count")
  nearMissCount           Int @default(0) @map("near_miss_count")
  propertyDamageCount     Int @default(0) @map("property_damage_count")
  environmentalSpillCount Int @default(0) @map("environmental_spill_count")
  processSafetyEventCount Int @default(0) @map("process_safety_event_count")
  totalDaysLost           Int @default(0) @map("total_days_lost")

  rateBaseHoursUsed Decimal @map("rate_base_hours_used") @db.Decimal(12, 0)
  ltifr             Decimal @db.Decimal(10, 4)
  trir              Decimal @db.Decimal(10, 4)
  severityRate      Decimal @map("severity_rate") @db.Decimal(10, 4)

  calculatedAt DateTime @map("calculated_at") @db.Timestamptz

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("IncidentStatisticsCacheCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("IncidentStatisticsCacheUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, periodType, periodStartDate])
  @@index([tenantId, siteId])
  @@map("incident_statistics_cache")
}

// ============================================================================
// Task 3.6 — Inspection Management (Modul 08). 10th domain module — TIDAK
// mengimpor domain module manapun. Modul ini "TIDAK WAJIB memakai Workflow
// Engine multi-stage" (PRD §4 poin 9, opsional/tenant-configurable) — TIDAK
// diimplementasikan sama sekali (gap TDD §26, scope-narrowing disengaja,
// tidak ada mekanisme skema utk "tenant ini pakai workflow, tenant lain
// tidak" TANPA menambah infrastruktur baru di luar literal PRD). Findings
// tertaut Modul 24 (Action Tracking, BELUM ADA, task 7.4) via event
// `inspection.finding_created` (EventEmitter2, TASK_INSTRUCTION.md literal
// "di-stub sebagai event") — BUKAN FK/NestJS import.
// ============================================================================

enum InspectionScoringMethod {
  PASS_FAIL_ONLY
  WEIGHTED_SCORE
  CHECKLIST_NO_SCORE
}

enum InspectionResponseType {
  PASS_FAIL
  YES_NO
  SCALE_1_5
  TEXT
  NUMERIC
}

enum InspectionRecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  CUSTOM_CRON
}

enum InspectionRecordStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum InspectionOverallResult {
  PASS
  FAIL
  NA
}

enum InspectionFindingSeverity {
  LOW
  MEDIUM
  HIGH
}

enum InspectionFindingStatus {
  OPEN
  ACTION_ASSIGNED
  IN_PROGRESS
  CLOSED
  ESCALATED_TO_CAPA
}

// `code` VARCHAR bebas (BUKAN enum tertutup) — PRD §2.1 "dan tipe custom
// lain", pola PERSIS work_permit_types.code (TDD §26 #104).
model InspectionType {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("inspection_type_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code        String  @db.VarChar(30)
  name        String  @db.VarChar(150)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("InspectionTypeCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("InspectionTypeUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  checklistTemplates InspectionChecklistTemplate[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("inspection_types")
}

// BR-07 — "perubahan versi TIDAK mengubah record historis... record
// menyimpan referensi versi snapshot." version INT (BUKAN tabel terpisah
// versi/parent) — versi BARU = BARIS BARU (version+1, isActive=true),
// baris LAMA TETAP ADA TIDAK PERNAH diupdate (isActive->false saja) —
// pola PERSIS RiskMatrixConfig (3.1, versioned CRUD).
model InspectionChecklistTemplate {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("inspection_checklist_template_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  inspectionTypeId String         @map("inspection_type_id") @db.Uuid
  inspectionType   InspectionType @relation(fields: [inspectionTypeId], references: [id])

  name    String @db.VarChar(150)
  version Int    @default(1)

  scoringMethod         InspectionScoringMethod @map("scoring_method")
  passingScoreThreshold Decimal?                @map("passing_score_threshold") @db.Decimal(5, 2)

  isActive      Boolean  @default(true) @map("is_active")
  effectiveDate DateTime @map("effective_date") @db.Date

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("InspectionChecklistTemplateCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("InspectionChecklistTemplateUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  items     InspectionChecklistTemplateItem[]
  schedules InspectionSchedule[]
  records   InspectionRecord[]

  @@unique([inspectionTypeId, version])
  @@index([tenantId, isActive])
  @@map("inspection_checklist_templates")
}

model InspectionChecklistTemplateItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("template_item_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  inspectionChecklistTemplateId String                      @map("inspection_checklist_template_id") @db.Uuid
  inspectionChecklistTemplate   InspectionChecklistTemplate @relation(fields: [inspectionChecklistTemplateId], references: [id])

  sequenceNo Int     @map("sequence_no")
  itemText   String  @map("item_text") @db.Text
  category   String? @db.VarChar(100)

