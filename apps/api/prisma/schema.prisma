  diagnosisCodesEncrypted         String? @map("diagnosis_codes_encrypted") @db.Text

  overallMcuResult OhMcuResultOverall @map("overall_mcu_result")

  fitToWorkAssessmentId String?              @map("fit_to_work_assessment_id") @db.Uuid
  fitToWorkAssessment   FitToWorkAssessment? @relation("McuResultFitToWorkAssessment", fields: [fitToWorkAssessmentId], references: [id])

  // §5 catatan lampiran PHI — TIDAK memakai bucket attachments generik,
  // bucket/folder terenkripsi terpisah + signed URL berdurasi pendek
  // (deferred, gap README). Field ini HANYA catatan referensi non-isi-file.
  reportFileAttachmentNote String? @map("report_file_attachment_note") @db.Text

  status OhMcuResultStatus @default(DRAFT)

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("McuResultCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("McuResultUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  fitToWorkAssessmentsBasedOn FitToWorkAssessment[] @relation("FitToWorkAssessmentRelatedMcuResult")

  @@index([tenantId, employeeUserId])
  @@index([tenantId, mcuScheduleId])
  @@map("mcu_results")
}

model FitToWorkAssessment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @map("fit_to_work_assessment_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  siteId       String      @map("site_id") @db.Uuid
  site         Site        @relation(fields: [siteId], references: [id])
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  employeeUserId String @map("employee_user_id") @db.Uuid
  employeeUser   User   @relation("FitToWorkAssessmentEmployee", fields: [employeeUserId], references: [id])

  assessmentDate    DateTime           @map("assessment_date") @db.Date
  assessmentTrigger OhFitToWorkTrigger @map("assessment_trigger")

  relatedMcuResultId String?    @map("related_mcu_result_id") @db.Uuid
  relatedMcuResult   McuResult? @relation("FitToWorkAssessmentRelatedMcuResult", fields: [relatedMcuResultId], references: [id])

  assessedBy     String @map("assessed_by") @db.Uuid
  assessedByUser User   @relation("FitToWorkAssessmentAssessedBy", fields: [assessedBy], references: [id])

  fitStatus OhFitStatus @map("fit_status")

  // [ENCRYPTED]
  restrictionDetailsEncrypted String? @map("restriction_details_encrypted") @db.Text

  // Boundary field non-klinis (§3.1 poin 5) — SENGAJA TIDAK dienkripsi,
  // dirancang eksplisit agar bisa diekspos ke Supervisor/Dept Head TANPA
  // melewati dual-gate BR-02 (beda structural dari restrictionDetails di atas).
  restrictionSummaryForSupervisor String? @map("restriction_summary_for_supervisor") @db.VarChar(255)

  restrictionValidFrom  DateTime? @map("restriction_valid_from") @db.Date
  restrictionValidUntil DateTime? @map("restriction_valid_until") @db.Date

  linkedRestrictedDutyAssignmentId String?                   @map("linked_restricted_duty_assignment_id") @db.Uuid
  linkedRestrictedDutyAssignment   RestrictedDutyAssignment? @relation("FitToWorkAssessmentLinkedRestrictedDuty", fields: [linkedRestrictedDutyAssignmentId], references: [id])

  nextReassessmentDate       DateTime? @map("next_reassessment_date") @db.Date
  // BEYOND kolom literal PRD §5 — idempotency occupational-health-reassessment-scan
  // (task 265), pola SAMA mcuSchedules.reminderSentAt/wasteGenerationLog.
  // storageDurationWarningSentAt (kolom TUNGGAL, bukan trigger ulang tiap
  // hari selama masih due — gap TDD §26 kalau PRD kelak minta reminder
  // berulang H-14/H-7/H-1 style spt MCU).
  reassessmentReminderSentAt DateTime? @map("reassessment_reminder_sent_at") @db.Timestamptz

  status OhFitToWorkAssessmentStatus @default(ACTIVE)

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("FitToWorkAssessmentCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("FitToWorkAssessmentUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  mcuResultsTriggered       McuResult[]                @relation("McuResultFitToWorkAssessment")
  restrictedDutyAssignments RestrictedDutyAssignment[] @relation("RestrictedDutyAssignmentSource")

  @@index([tenantId, employeeUserId])
  @@map("fit_to_work_assessments")
}

