model TenantSubscription {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @map("tenant_subscription_id") @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  tenant             Tenant                   @relation(fields: [tenantId], references: [id])
  subscriptionPlanId String                   @map("subscription_plan_id") @db.Uuid
  subscriptionPlan   SubscriptionPlan         @relation(fields: [subscriptionPlanId], references: [id])
  billingPeriod      BillingPeriod            @map("billing_period")
  status             TenantSubscriptionStatus @default(TRIAL)
