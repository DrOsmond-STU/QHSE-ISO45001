  // PRD py DUA kolom FK yang saling menunjuk antara audits <-> audit_program_
  // plan_items ("audit_program_plan_item_id" DI SINI + "linked_audit_id" di
  // sana) — BUKAN duplikasi keliru, dua tujuan beda: kolom INI historis-
  // immutable ("audit ini berasal dari plan item mana", diisi SEKALI saat
  // create, NULL kalau ad-hoc — §4 poin 2), linked_audit_id di plan item
  // sebaliknya kolom "status realisasi" (dipakai KPI §9 "planned vs
  // executed"). AuditService.createFromPlanItem() mengisi KEDUANYA atomik
  // dalam satu transaksi yang sama.
  auditProgramPlanItemId String?               @unique @map("audit_program_plan_item_id") @db.Uuid
  auditProgramPlanItem   AuditProgramPlanItem? @relation("AuditOriginPlanItem", fields: [auditProgramPlanItemId], references: [id])
  linkedFromPlanItem     AuditProgramPlanItem? @relation("AuditProgramPlanItemLinkedAudit")

  auditTypeId String    @map("audit_type_id") @db.Uuid
  auditType   AuditType @relation(fields: [auditTypeId], references: [id])

  auditChecklistId String         @map("audit_checklist_id") @db.Uuid
  auditChecklist   AuditChecklist @relation(fields: [auditChecklistId], references: [id])

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  branchId  String? @map("branch_id") @db.Uuid
  branch    Branch? @relation(fields: [branchId], references: [id])
  siteId    String  @map("site_id") @db.Uuid
  site      Site    @relation(fields: [siteId], references: [id])

  leadAuditorId String @map("lead_auditor_id") @db.Uuid
  leadAuditor   User   @relation("AuditLeadAuditor", fields: [leadAuditorId], references: [id])

  plannedStartDate DateTime  @map("planned_start_date") @db.Date
  plannedEndDate   DateTime  @map("planned_end_date") @db.Date
  actualStartDate  DateTime? @map("actual_start_date") @db.Date
  actualEndDate    DateTime? @map("actual_end_date") @db.Date

  openingMeetingDatetime DateTime? @map("opening_meeting_datetime") @db.Timestamptz
  openingMeetingNotes    String?   @map("opening_meeting_notes") @db.Text
  closingMeetingDatetime DateTime? @map("closing_meeting_datetime") @db.Timestamptz
  closingMeetingNotes    String?   @map("closing_meeting_notes") @db.Text

  status            AuditStatus @default(PLANNED)
  overallConclusion String?     @map("overall_conclusion") @db.Text

  // Denormalized copy dari audit_reports.workflow_instance_id — PRD literal
  // py KEDUA kolom ini, label "approval laporan" DI SINI eksplisit merujuk
  // ke workflow YANG SAMA dgn audit_reports (entity_type Workflow Engine
  // TETAP "audit_report"/entityId=audit_reports.id per PRD §4 poin 7, TIDAK
  // PERNAH "audits" langsung). AuditReportService menulis kolom ini
  // SEKALIGUS dgn audit_reports.workflow_instance_id dalam SATU service
  // method (submitForApproval()) supaya kedua nilai tidak pernah divergen
  // — interpretasi convenience-pointer, PRD tidak menjelaskan alasan dua
  // kolom, gap TDD §26.
  workflowInstanceId String?           @unique @map("workflow_instance_id") @db.Uuid
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("AuditCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("AuditUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  teamMembers   AuditTeamMember[]
  auditeeScopes AuditAuditeeScope[]
  findings      AuditFinding[]
  report        AuditReport?

  @@unique([tenantId, auditNumber])
  @@index([tenantId, status])
  @@index([auditTypeId])
  @@index([auditChecklistId])
  @@index([companyId])
  @@index([branchId])
  @@index([siteId])
  @@index([leadAuditorId])
  @@map("audits")
}

