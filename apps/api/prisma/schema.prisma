  identifiedAt     DateTime @map("identified_at") @db.Timestamptz

  targetCloseDate DateTime? @map("target_close_date") @db.Date
  closedAt        DateTime? @map("closed_at") @db.Timestamptz

  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("InspectionFindingCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("InspectionFindingUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, inspectionRecordId])
  @@index([tenantId, severity, actionTrackingId])
  @@map("inspection_findings")
}

// Ringkasan skor per kategori dalam 1 inspeksi (BEDA dari overall_score —
